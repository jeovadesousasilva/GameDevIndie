---
import { withBase } from '../utils/paths';

const siteUrl = 'https://midnighttoronto.com.br';
const pagePath = 'loja/';
const canonicalUrl = `${siteUrl}${withBase(pagePath)}`;
const faviconHref = withBase('favicon.png');
const roleplayUrl = withBase('171-brasil-roleplay/');
const termsUrl = withBase('termos-loja/');
const discordUrl = 'https://discord.gg/6GwbJRFhQU';
const storeApiBaseUrl = 'https://liberty-immovably-bacon.ngrok-free.dev';
const studioAsset = withBase('midnight-toronto/assets');
const logoImage = `${studioAsset}/images/midnight-city/171-brasil-roleplay-logo-v3.png`;
const socialImage = `${siteUrl}${withBase('midnight-toronto/assets/images/midnight-city/171-brasil-roleplay-logo-v3.png')}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const storeTermsVersion = '2026-07-30';

const categories = [
	{ id: 'dinheiro', label: 'Dinheiro', icon: '💵' },
	{ id: 'vips', label: 'VIPs', icon: '💎' },
	{ id: 'inventario', label: 'Inventário', icon: '🎒' },
	{ id: 'garagem', label: 'Garagem', icon: '🚗' },
	{ id: 'ids', label: 'IDs', icon: '🆔' }
];

const products = [
	{
		category: 'dinheiro',
		checkoutProductId: 'cash_4kk',
		icon: '4KK',
		name: '4kk de dinheiro',
		description: 'Saldo inicial para comprar itens, veículos e recursos dentro da cidade.',
		price: 'R$ 0,10',
		badge: '4 milhões'
	},
	{
		category: 'dinheiro',
		checkoutProductId: 'cash_8kk',
		icon: '8KK',
		name: '8kk de dinheiro',
		description: 'Pacote equilibrado para começar com mais liberdade no roleplay.',
		price: 'R$ 0,10',
		badge: '8 milhões',
		featured: true
	},
	{
		category: 'dinheiro',
		checkoutProductId: 'cash_15kk',
		icon: '15KK',
		name: '15kk de dinheiro',
		description: 'Mais saldo para guardar, investir e aproveitar futuras novidades.',
		price: 'R$ 0,10',
		badge: '15 milhões'
	},
	{
		category: 'vips',
		icon: 'VIP',
		name: 'VIP Mensal',
		description: 'Tag VIP, visual especial e benefícios planejados para quem quer apoiar o servidor.',
		price: 'R$ 25,00',
		badge: 'indisponível',
		unavailable: true
	},
	{
		category: 'inventario',
		icon: '🎒',
		name: 'Página extra de inventário',
		description: 'Mais uma página para guardar itens importantes. Produto planejado para uma fase futura.',
		price: 'Em breve',
		badge: 'não disponível',
		unavailable: true
	},
	{
		category: 'garagem',
		checkoutProductId: 'garage_slot_1',
		icon: '+1',
		name: '+1 slot de garagem',
		description: 'Libera mais um espaço para guardar veículo na conta do jogador.',
		price: 'R$ 0,10',
		badge: '+1 veículo'
	},
	{
		category: 'garagem',
		checkoutProductId: 'garage_slot_3',
		icon: '+3',
		name: '+3 slots de garagem',
		description: 'Mais espaços para quem quer colecionar carros, motos e veículos especiais.',
		price: 'R$ 0,10',
		badge: '+3 veículos'
	},
	{
		category: 'ids',
		icon: '3 Dig',
		name: 'ID 3 dígitos',
		description: 'Reserva de ID especial com três dígitos para deixar a conta mais marcante.',
		price: 'R$ 20,00',
		badge: 'indisponível',
		unavailable: true
	},
	{
		category: 'ids',
		icon: '2 Dig',
		name: 'ID 2 dígitos',
		description: 'ID curto e raro para jogadores que querem uma identificação premium.',
		price: 'R$ 40,00',
		badge: 'indisponível',
		unavailable: true
	},
	{
		category: 'ids',
		icon: 'Pers.',
		name: 'ID personalizado',
		description: 'Escolha um ID disponível e combine a reserva com a equipe do servidor.',
		price: 'R$ 60,00',
		badge: 'indisponível',
		unavailable: true,
		compactIcon: true
	}
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Loja 171 Brasil Roleplay | Dinheiro, VIP, Garagem e IDs</title>
		<meta
			name="description"
			content="Loja da 171 Brasil Roleplay com dinheiro, VIP, slots de garagem, IDs especiais e inventário em breve."
		/>
		<meta
			name="keywords"
			content="loja 171 brasil roleplay, dinheiro samp, vip samp, id samp, garagem samp, inventário samp"
		/>
		<meta name="author" content="Jeová de Sousa" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href={faviconHref} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content="Loja 171 Brasil Roleplay" />
		<meta
			property="og:description"
			content="Dinheiro, VIP, slots de garagem e IDs especiais para a 171 Brasil Roleplay."
		/>
		<meta property="og:image" content={socialImage} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content="Loja 171 Brasil Roleplay" />
		<meta
			property="twitter:description"
			content="Dinheiro, VIP, slots de garagem e IDs especiais para a 171 Brasil Roleplay."
		/>
		<meta property="twitter:image" content={socialImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
		{turnstileSiteKey && (
			<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
		)}
	</head>
	<body>
		<div
			class="shop-page"
			data-store-api-base={storeApiBaseUrl}
			data-turnstile-site-key={turnstileSiteKey}
			data-terms-version={storeTermsVersion}
		>
			<header class="shop-header">
				<div class="shop-container shop-header-inner">
					<a href={roleplayUrl} class="shop-brand">
						<span class="shop-logo">
							<img src={logoImage} alt="Logo da 171 Brasil Roleplay" />
						</span>
						<span>
							<strong>171 Brasil RP</strong>
							<small>Loja oficial</small>
						</span>
					</a>

					<div class="shop-header-actions">
						<a href={roleplayUrl} class="shop-icon-button" aria-label="Início">
							<span>🏠</span>
						</a>
						<button type="button" class="shop-icon-button" data-search-toggle aria-label="Pesquisar produto">
							<span>🔍</span>
						</button>
						<a href={discordUrl} target="_blank" rel="noreferrer" class="shop-icon-button" aria-label="Suporte">
							<span>🎧</span>
						</a>
					<label class="shop-search" data-search-box aria-label="Buscar produto" hidden>
						<span>🔍</span>
						<input data-product-search type="search" placeholder="Buscar produto" />
					</label>

					<button type="button" class="shop-account-button shop-icon-button" data-open-login aria-label="Conta do jogador">
						<span>👤</span>
						<strong data-account-button-label>Conta</strong>
					</button>
					</div>
				</div>
			</header>

			<main>
				<section class="shop-hero">
					<div class="shop-container shop-hero-grid">
						<div class="shop-hero-card">
							<p class="shop-eyebrow">SA-MP Mobile</p>
							<h1>Loja 171 Brasil Roleplay</h1>
							<p>
								Compre dinheiro, VIP, slots de garagem e IDs especiais para deixar sua conta do
								jeito que você quer.
							</p>

							<div class="shop-hero-actions">
								<a href="#produtos" class="shop-button shop-button-primary">Ver produtos</a>
								<a href={discordUrl} target="_blank" rel="noreferrer" class="shop-button shop-button-light">
									Chamar suporte
								</a>
							</div>
						</div>

					</div>
				</section>

				<section class="shop-support">
					<div class="shop-container shop-support-inner">
						<div>
							<p class="shop-section-label">Atendimento</p>
							<h2>Canais de suporte</h2>
						</div>
						<div class="shop-support-links">
							<a href={discordUrl} target="_blank" rel="noreferrer">Discord</a>
							<a href="#produtos">Catálogo</a>
							<a href={roleplayUrl}>Página do servidor</a>
						</div>
					</div>
				</section>

				<section class="shop-account-panel" data-account-panel hidden>
					<button type="button" class="shop-account-page-backdrop" data-account-panel-close aria-label="Voltar para a loja"></button>
					<div class="shop-container">
						<div class="shop-account-shell">
							<button type="button" class="shop-account-back" data-account-panel-close>
								<span>←</span>
								Voltar para loja
							</button>

							<div class="shop-account-cover">
								<div class="shop-dashboard-skin">
									<img data-dashboard-skin alt="Skin da conta logada" />
								</div>
								<div>
									<p class="shop-section-label">Área exclusiva</p>
									<h2 data-dashboard-name>Jogador</h2>
									<span data-dashboard-id>ID #---</span>
								</div>
							</div>

							<div class="shop-account-tabs" aria-label="Categorias da conta">
								<button type="button" class="is-active" data-account-tab="resumo">Resumo</button>
								<button type="button" data-account-tab="garagem">Garagem</button>
								<button type="button" data-account-tab="pedidos">Pedidos</button>
							</div>

							<div class="shop-account-view is-active" data-account-view="resumo">
								<div class="shop-dashboard-stats">
									<article>
										<span>Membro desde</span>
										<strong data-dashboard-member>--</strong>
									</article>
									<article>
										<span>Dinheiro</span>
										<strong data-dashboard-money>R$ 0</strong>
									</article>
									<article>
										<span>Level geral</span>
										<strong data-dashboard-level>0</strong>
									</article>
									<article>
										<span>Slots garagem</span>
										<strong data-dashboard-slots>0</strong>
									</article>
								</div>
							</div>

							<div class="shop-account-view" data-account-view="garagem" hidden>
								<div class="shop-dashboard-section">
									<div>
										<p class="shop-section-label">Garagem</p>
										<h3>Veículos da conta</h3>
									</div>
									<div class="shop-vehicle-grid" data-dashboard-vehicles></div>
								</div>
							</div>

							<div class="shop-account-view" data-account-view="pedidos" hidden>
								<div class="shop-dashboard-section">
									<div>
										<p class="shop-section-label">Histórico</p>
										<h3>Últimos pedidos</h3>
									</div>
									<div class="shop-order-list" data-dashboard-orders></div>
								</div>
							</div>

							<div class="shop-dashboard-actions">
								<button type="button" class="shop-pix-copy" data-dashboard-refresh>Atualizar painel</button>
								<button type="button" class="shop-pix-open" data-logout>Desconectar</button>
							</div>

							<div class="shop-pix-state" data-dashboard-state>
								Painel carregado.
							</div>
						</div>
					</div>
				</section>

				<section id="produtos" class="shop-products">
					<div class="shop-container">
						<div class="shop-section-head">
							<p class="shop-section-label">Categorias</p>
							<h2>Escolha seu produto</h2>
						</div>

						<div class="shop-categories" aria-label="Categorias da loja">
							{categories.map((category) => (
								<a href={`#${category.id}`}>
									<span>{category.icon}</span>
									{category.label}
								</a>
							))}
						</div>

						{categories.map((category) => (
							<section id={category.id} class="shop-category-block" aria-labelledby={`${category.id}-title`}>
								<div class="shop-category-title">
									<span>{category.icon}</span>
									<h3 id={`${category.id}-title`}>{category.label}</h3>
								</div>

								<div class="shop-grid">
									{products
										.filter((product) => product.category === category.id)
										.map((product) => (
											<article class:list={[
												'shop-product',
												`shop-product-${product.category}`,
												{
													'shop-product-featured': product.featured,
													'shop-product-unavailable': product.unavailable,
													'shop-product-compact-icon': product.compactIcon
												}
											]} data-product-card data-search={`${product.name} ${product.description} ${product.badge} ${category.label}`}>
												<div class="shop-product-media" aria-hidden="true">
													<div class="shop-product-visual">
														<span class="shop-product-icon">{product.icon}</span>
													</div>
												</div>
												<div class="shop-product-body">
													<div class="shop-product-top">
														<h4>{product.name}</h4>
														<span class="shop-badge">{product.badge}</span>
													</div>
													<p>{product.description}</p>
													<div class="shop-product-meta">
														<span>🚀 Entrega imediata</span>
														<em>Pix</em>
													</div>
												<div class="shop-product-bottom">
													<strong>{product.price}</strong>
													{product.unavailable ? (
														<button type="button" class="shop-product-disabled" disabled>
															Indisponível
														</button>
													) : product.checkoutProductId ? (
														<button
															type="button"
															class="shop-buy-button"
															data-product-id={product.checkoutProductId}
															data-product-name={product.name}
															aria-label={`Comprar ${product.name}`}
														>
															<span>🛒</span>
															Comprar agora
														</button>
													) : (
														<a
															href={discordUrl}
															target="_blank"
															rel="noreferrer"
															aria-label={`Comprar ${product.name}`}
														>
															Solicitar
														</a>
													)}
												</div>
												</div>
											</article>
										))}
								</div>
							</section>
						))}
					</div>
				</section>

			</main>

			<footer class="shop-footer">
				<div class="shop-container shop-footer-inner">
					<p>171 Brasil Roleplay by Midnight Toronto</p>
					<a href={discordUrl} target="_blank" rel="noreferrer">Suporte no Discord</a>
				</div>
			</footer>
		</div>

		<div class="shop-login-modal" data-login-modal hidden>
			<div class="shop-pix-backdrop" data-login-close></div>
			<section class="shop-pix-dialog shop-login-dialog" role="dialog" aria-modal="true" aria-labelledby="login-modal-title">
				<button type="button" class="shop-pix-close" data-login-close aria-label="Fechar login">
					×
				</button>
				<p class="shop-section-label">Conta 171 Brasil RP</p>
				<h2 id="login-modal-title">Entre para ver seu painel</h2>
				<p class="shop-login-text">
					Use o mesmo ID e senha da sua conta do servidor. Se preferir, você ainda pode comprar sem login.
				</p>

				<div class="shop-login-form">
					<label for="site-login-id">ID da conta</label>
					<input id="site-login-id" data-login-id type="number" inputmode="numeric" placeholder="Ex: 103566" autocomplete="username" />

					<label for="site-login-password">Senha</label>
					<input id="site-login-password" data-login-password type="password" placeholder="Senha da conta" autocomplete="current-password" />

					<div class="shop-captcha-box" data-login-turnstile>
						<span>Proteção anti-robô será exibida aqui.</span>
					</div>

					<button type="button" class="shop-pix-copy" data-login-submit>Entrar na conta</button>
					<button type="button" class="shop-pix-open" data-login-skip>Comprar sem login</button>
				</div>

				<div class="shop-pix-loading shop-login-loading" data-login-loading hidden>
					<span></span>
					Entrando com segurança...
				</div>

				<div class="shop-pix-state" data-login-state>
					Sua sessão fica salva neste navegador.
				</div>
			</section>
		</div>

		<div class="shop-dashboard-modal" data-dashboard-modal hidden>
			<div class="shop-pix-backdrop" data-dashboard-close></div>
			<section class="shop-dashboard-dialog" role="dialog" aria-modal="true" aria-labelledby="dashboard-modal-title">
				<button type="button" class="shop-pix-close" data-dashboard-close aria-label="Fechar painel da conta">
					×
				</button>

				<div class="shop-dashboard-head">
					<div class="shop-dashboard-skin">
						<img data-dashboard-skin alt="Skin da conta logada" />
					</div>
					<div>
						<p class="shop-section-label">Minha conta</p>
						<h2 id="dashboard-modal-title" data-dashboard-name>Jogador</h2>
						<span data-dashboard-id>ID #---</span>
					</div>
				</div>

				<div class="shop-dashboard-stats">
					<article>
						<span>Membro desde</span>
						<strong data-dashboard-member>--</strong>
					</article>
					<article>
						<span>Dinheiro</span>
						<strong data-dashboard-money>R$ 0</strong>
					</article>
					<article>
						<span>Level geral</span>
						<strong data-dashboard-level>0</strong>
					</article>
					<article>
						<span>Slots garagem</span>
						<strong data-dashboard-slots>0</strong>
					</article>
				</div>

				<div class="shop-dashboard-section">
					<div>
						<p class="shop-section-label">Garagem</p>
						<h3>Veículos da conta</h3>
					</div>
					<div class="shop-vehicle-grid" data-dashboard-vehicles></div>
				</div>

				<div class="shop-dashboard-section">
					<div>
						<p class="shop-section-label">Histórico</p>
						<h3>Últimos pedidos</h3>
					</div>
					<div class="shop-order-list" data-dashboard-orders></div>
				</div>

				<div class="shop-dashboard-actions">
					<button type="button" class="shop-pix-copy" data-dashboard-refresh>Atualizar painel</button>
					<button type="button" class="shop-pix-open" data-logout>Desconectar</button>
				</div>

				<div class="shop-pix-state" data-dashboard-state>
					Painel carregado.
				</div>
			</section>
		</div>

		<div class="shop-account-modal" data-account-modal hidden>
			<div class="shop-pix-backdrop" data-account-close></div>
			<section class="shop-pix-dialog shop-account-dialog" role="dialog" aria-modal="true" aria-labelledby="account-modal-title">
				<button type="button" class="shop-pix-close" data-account-close aria-label="Fechar confirmação de conta">
					×
				</button>
				<p class="shop-section-label">Confirme sua conta</p>
				<h2 id="account-modal-title">Digite seu ID</h2>
				<p class="shop-pix-summary" data-account-product>Produto selecionado</p>

				<div class="shop-account-form">
					<label for="account-checkout-id">ID da conta</label>
					<div class="shop-id-preview">
						<input id="account-checkout-id" data-account-input type="number" inputmode="numeric" placeholder="Ex: 103566" />
						<button type="button" data-account-verify>Verificar</button>
					</div>
				</div>

				<div class="shop-pix-loading shop-account-loading" data-account-loading hidden>
					<span></span>
					Verificando conta...
				</div>

				<div class="shop-account-result" data-account-result hidden>
					<div class="shop-skin-card">
						<img data-account-skin-image alt="Modelo visual da skin da conta" />
						<span>Skin</span>
						<strong data-account-skin>#0</strong>
					</div>
					<div>
						<p>Nome da conta</p>
						<strong data-account-name>Jogador</strong>
					</div>
					<div>
						<p>Level geral</p>
						<strong data-account-level>Não disponível</strong>
					</div>
				</div>

				<div class="shop-account-actions">
					<button type="button" class="shop-pix-copy" data-account-confirm hidden>Sim, é minha conta</button>
					<button type="button" class="shop-pix-open" data-account-change hidden>Trocar ID</button>
				</div>

				<div class="shop-pix-state" data-account-state>
					Informe o ID público da sua conta.
				</div>
			</section>
		</div>

		<div class="shop-terms-modal" data-terms-modal hidden>
			<div class="shop-pix-backdrop" data-terms-close></div>
			<section class="shop-pix-dialog shop-terms-dialog" role="dialog" aria-modal="true" aria-labelledby="terms-modal-title">
				<button type="button" class="shop-pix-close" data-terms-close aria-label="Fechar termos da loja">
					×
				</button>
				<p class="shop-section-label">Termos da loja</p>
				<h2 id="terms-modal-title">Confirme antes de gerar o Pix</h2>
				<p class="shop-pix-summary" data-terms-summary>
					Revise as regras da compra antes de continuar.
				</p>

				<div class="shop-terms-card">
					<ul>
						<li>Você confirma que o ID informado é da sua conta no servidor.</li>
						<li>A entrega é automática após a confirmação do pagamento pelo Mercado Pago.</li>
						<li>Produtos digitais não devem ser transferidos para outra conta sem suporte.</li>
						<li>Compras suspeitas, duplicadas ou contestadas podem ser bloqueadas para análise.</li>
					</ul>
					<a href={termsUrl} target="_blank" rel="noreferrer">Abrir termos completos</a>
				</div>

				<label class="shop-terms-check">
					<input type="checkbox" data-terms-check />
					<span>Li e aceito os termos da loja do 171 Brasil Roleplay.</span>
				</label>

				<div class="shop-captcha-box" data-checkout-turnstile>
					<span>Confirmação anti-robô será exibida aqui para compras sem login.</span>
				</div>

				<div class="shop-account-actions">
					<button type="button" class="shop-pix-open" data-terms-back>Voltar</button>
					<button type="button" class="shop-pix-copy" data-terms-confirm disabled>Gerar Pix</button>
				</div>

				<div class="shop-pix-state" data-terms-state>
					Marque o aceite para continuar.
				</div>
			</section>
		</div>

		<div class="shop-pix-modal" data-pix-modal hidden>
			<div class="shop-pix-backdrop" data-pix-close></div>
			<section class="shop-pix-dialog" role="dialog" aria-modal="true" aria-labelledby="pix-modal-title">
				<button type="button" class="shop-pix-close" data-pix-close aria-label="Fechar pagamento Pix">
					×
				</button>
				<p class="shop-section-label">Pagamento Pix</p>
				<h2 id="pix-modal-title">Finalize no Pix</h2>
				<p class="shop-pix-summary" data-pix-summary>Preparando pagamento...</p>

				<div class="shop-pix-loading" data-pix-loading>
					<span></span>
					Gerando QR Code seguro...
				</div>

				<div class="shop-pix-content" data-pix-content hidden>
					<div class="shop-pix-qr">
						<img data-pix-qr alt="QR Code Pix para pagamento" />
					</div>
					<label for="pix-copy-code">Pix copia e cola</label>
					<textarea id="pix-copy-code" data-pix-code readonly></textarea>
					<button type="button" class="shop-pix-copy" data-pix-copy>Copiar código Pix</button>
					<a class="shop-pix-open" data-pix-open target="_blank" rel="noreferrer" hidden>
						Abrir página do Pix
					</a>
				</div>

				<div class="shop-pix-success" data-pix-success hidden>
					<div class="shop-success-icon">✓</div>
					<h3>Pedido confirmado</h3>
					<p>
						Pagamento aprovado. Estamos finalizando a entrega na sua conta.
					</p>
					<div class="shop-delivery-flow" data-delivery-flow>
						<div class="shop-delivery-bar">
							<span data-delivery-bar></span>
						</div>
						<div class="shop-delivery-steps">
							<div class="is-active" data-delivery-step="1">
								<span>1</span>
								<strong>Pedido pago</strong>
							</div>
							<div data-delivery-step="2">
								<span>2</span>
								<strong>Processando</strong>
							</div>
							<div data-delivery-step="3">
								<span>3</span>
								<strong>Entregue</strong>
							</div>
						</div>
					</div>
				</div>

				<div class="shop-pix-state" data-pix-state>
					Aguardando geração do Pix.
				</div>
			</section>
		</div>

		<script>
			(() => {
				const page = document.querySelector('.shop-page');
				const apiBase = page?.getAttribute('data-store-api-base') || '';
				const turnstileSiteKey = page?.getAttribute('data-turnstile-site-key') || '';
				const termsVersion = page?.getAttribute('data-terms-version') || '2026-07-30';
				const statusEl = document.querySelector('[data-shop-status]');
				const buyButtons = document.querySelectorAll('.shop-buy-button');
				const productSearch = document.querySelector('[data-product-search]');
				const searchBox = document.querySelector('[data-search-box]');
				const searchToggle = document.querySelector('[data-search-toggle]');
				const productCards = document.querySelectorAll('[data-product-card]');
				const categoryBlocks = document.querySelectorAll('.shop-category-block');
				const openLoginButton = document.querySelector('[data-open-login]');
				const accountButtonLabel = document.querySelector('[data-account-button-label]');
				const loginModal = document.querySelector('[data-login-modal]');
				const loginId = document.querySelector('[data-login-id]');
				const loginPassword = document.querySelector('[data-login-password]');
				const loginSubmit = document.querySelector('[data-login-submit]');
				const loginSkip = document.querySelector('[data-login-skip]');
				const loginLoading = document.querySelector('[data-login-loading]');
				const loginState = document.querySelector('[data-login-state]');
				const accountPanel = document.querySelector('[data-account-panel]');
				const accountTabs = document.querySelectorAll('[data-account-tab]');
				const accountViews = document.querySelectorAll('[data-account-view]');
				const dashboardModal = document.querySelector('[data-dashboard-modal]');
				const dashboardName = document.querySelector('[data-dashboard-name]');
				const dashboardId = document.querySelector('[data-dashboard-id]');
				const dashboardSkin = document.querySelector('[data-dashboard-skin]');
				const dashboardMember = document.querySelector('[data-dashboard-member]');
				const dashboardMoney = document.querySelector('[data-dashboard-money]');
				const dashboardLevel = document.querySelector('[data-dashboard-level]');
				const dashboardSlots = document.querySelector('[data-dashboard-slots]');
				const dashboardVehicles = document.querySelector('[data-dashboard-vehicles]');
				const dashboardOrders = document.querySelector('[data-dashboard-orders]');
				const dashboardRefresh = document.querySelector('[data-dashboard-refresh]');
				const dashboardState = document.querySelector('[data-dashboard-state]');
				const logoutButton = document.querySelector('[data-logout]');
				const accountModal = document.querySelector('[data-account-modal]');
				const accountInput = document.querySelector('[data-account-input]');
				const accountProduct = document.querySelector('[data-account-product]');
				const accountLoading = document.querySelector('[data-account-loading]');
				const accountResult = document.querySelector('[data-account-result]');
				const accountName = document.querySelector('[data-account-name]');
				const accountSkin = document.querySelector('[data-account-skin]');
				const accountSkinImage = document.querySelector('[data-account-skin-image]');
				const accountLevel = document.querySelector('[data-account-level]');
				const accountState = document.querySelector('[data-account-state]');
				const accountVerify = document.querySelector('[data-account-verify]');
				const accountConfirm = document.querySelector('[data-account-confirm]');
				const accountChange = document.querySelector('[data-account-change]');
				const termsModal = document.querySelector('[data-terms-modal]');
				const termsSummary = document.querySelector('[data-terms-summary]');
				const termsCheck = document.querySelector('[data-terms-check]');
				const termsConfirm = document.querySelector('[data-terms-confirm]');
				const termsBack = document.querySelector('[data-terms-back]');
				const termsState = document.querySelector('[data-terms-state]');
				const loginTurnstile = document.querySelector('[data-login-turnstile]');
				const checkoutTurnstile = document.querySelector('[data-checkout-turnstile]');
				const pixModal = document.querySelector('[data-pix-modal]');
				const modalSummary = document.querySelector('[data-pix-summary]');
				const modalLoading = document.querySelector('[data-pix-loading]');
				const modalContent = document.querySelector('[data-pix-content]');
				const modalSuccess = document.querySelector('[data-pix-success]');
				const modalQr = document.querySelector('[data-pix-qr]');
				const modalCode = document.querySelector('[data-pix-code]');
				const modalCopy = document.querySelector('[data-pix-copy]');
				const modalOpen = document.querySelector('[data-pix-open]');
				const modalState = document.querySelector('[data-pix-state]');
				const deliveryBar = document.querySelector('[data-delivery-bar]');
				const deliverySteps = document.querySelectorAll('[data-delivery-step]');
				const fetchHeaders = { 'ngrok-skip-browser-warning': 'true' };
				let pollTimer = null;
				let deliveryFlowTimers = [];
				let selectedProduct = null;
				let selectedAccount = null;
				let loggedAccount = null;

				const setStatus = (message, type = 'info') => {
					if (!statusEl) return;
					statusEl.textContent = message;
					statusEl.dataset.status = type;
				};

				const setPixState = (message, type = 'info') => {
					if (!modalState) return;
					modalState.textContent = message;
					modalState.dataset.status = type;
				};

				const setAccountState = (message, type = 'info') => {
					if (!accountState) return;
					accountState.textContent = message;
					accountState.dataset.status = type;
				};

				const setLoginState = (message, type = 'info') => {
					if (!loginState) return;
					loginState.textContent = message;
					loginState.dataset.status = type;
				};

				const setTermsState = (message, type = 'info') => {
					if (!termsState) return;
					termsState.textContent = message;
					termsState.dataset.status = type;
				};

				const setDashboardState = (message, type = 'info') => {
					if (!dashboardState) return;
					dashboardState.textContent = message;
					dashboardState.dataset.status = type;
				};

				const formatDate = (value) => {
					if (!value) return '--';
					const date = new Date(value);
					if (Number.isNaN(date.getTime())) return '--';
					return new Intl.DateTimeFormat('pt-BR').format(date);
				};

				const formatMoney = (value) =>
					new Intl.NumberFormat('pt-BR', {
						style: 'currency',
						currency: 'BRL',
						maximumFractionDigits: 0
					}).format(Number(value || 0));

				const formatOrderStatus = (status, deliveryStatus) => {
					if (deliveryStatus === 'entregue' || status === 'entregue') return 'Entregue';
					if (status === 'pago') return 'Pago';
					if (status === 'cancelado') return 'Cancelado';
					if (status === 'erro' || deliveryStatus === 'erro') return 'Suporte';
					return 'Aguardando';
				};

				const escapeHtml = (value) =>
					String(value ?? '').replace(/[&<>"']/g, (character) => ({
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						'"': '&quot;',
						"'": '&#39;'
					})[character]);

				const captcha = {
					login: { target: loginTurnstile, widgetId: null, token: '' },
					checkout: { target: checkoutTurnstile, widgetId: null, token: '' }
				};

				const renderCaptcha = (name) => {
					const item = captcha[name];
					if (!item?.target) return;

					if (!turnstileSiteKey) {
						item.target.innerHTML = '<span>Captcha não configurado neste ambiente de teste.</span>';
						return;
					}

					if (!window.turnstile) {
						window.setTimeout(() => renderCaptcha(name), 180);
						return;
					}

					if (item.widgetId !== null) return;
					item.target.innerHTML = '';
					item.widgetId = window.turnstile.render(item.target, {
						sitekey: turnstileSiteKey,
						callback: (token) => {
							item.token = token;
							if (name === 'checkout') setTermsState('Proteção confirmada. Você já pode gerar o Pix.', 'success');
							if (name === 'login') setLoginState('Proteção confirmada. Agora é só entrar.', 'success');
						},
						'expired-callback': () => {
							item.token = '';
							if (name === 'checkout') setTermsState('Captcha expirou. Confirme novamente para continuar.', 'error');
							if (name === 'login') setLoginState('Captcha expirou. Confirme novamente para entrar.', 'error');
						},
						'error-callback': () => {
							item.token = '';
							if (name === 'checkout') setTermsState('Não foi possível carregar o captcha. Tente novamente.', 'error');
							if (name === 'login') setLoginState('Não foi possível carregar o captcha. Tente novamente.', 'error');
						}
					});
				};

				const resetCaptcha = (name) => {
					const item = captcha[name];
					if (!item) return;
					item.token = '';
					if (item.widgetId !== null && window.turnstile) {
						window.turnstile.reset(item.widgetId);
					}
				};

				const getCaptchaToken = (name) => {
					if (!turnstileSiteKey) return '';
					const token = captcha[name]?.token || '';
					if (!token) {
						throw new Error('Confirme o captcha para continuar.');
					}
					return token;
				};

				const openModal = (modal) => {
					if (!modal) return;
					modal.hidden = false;
					document.body.classList.add('shop-modal-open');
				};

				const closeModal = (modal) => {
					if (!modal) return;
					modal.hidden = true;
					if (accountModal?.hidden && termsModal?.hidden && pixModal?.hidden && loginModal?.hidden && dashboardModal?.hidden && accountPanel?.hidden) {
						document.body.classList.remove('shop-modal-open');
					}
				};

				const closePixModal = () => {
					closeModal(pixModal);
					if (pollTimer) window.clearInterval(pollTimer);
					pollTimer = null;
					deliveryFlowTimers.forEach((timer) => window.clearTimeout(timer));
					deliveryFlowTimers = [];
				};

				const resetAccountModal = () => {
					selectedAccount = null;
					if (accountInput) {
						accountInput.value = '';
						accountInput.disabled = false;
					}
					if (accountProduct) accountProduct.textContent = selectedProduct?.name || 'Produto selecionado';
					if (accountLoading) accountLoading.hidden = true;
					if (accountResult) accountResult.hidden = true;
					if (accountConfirm) accountConfirm.hidden = true;
					if (accountChange) accountChange.hidden = true;
					setAccountState('Informe o ID público da sua conta.', 'info');
				};

				const resetPixModal = (productName, accountId) => {
					if (modalSummary) modalSummary.textContent = `${productName} para o ID ${accountId}`;
					if (modalLoading) modalLoading.hidden = false;
					if (modalContent) modalContent.hidden = true;
					if (modalSuccess) modalSuccess.hidden = true;
					if (modalQr) modalQr.removeAttribute('src');
					if (modalCode) modalCode.value = '';
					if (modalOpen) {
						modalOpen.hidden = true;
						modalOpen.removeAttribute('href');
					}
					if (deliveryBar) deliveryBar.style.width = '0%';
					deliverySteps.forEach((step, index) => step.classList.toggle('is-active', index === 0));
					deliveryFlowTimers.forEach((timer) => window.clearTimeout(timer));
					deliveryFlowTimers = [];
					setPixState('Gerando Pix seguro...', 'info');
				};

				const updateAccountButton = () => {
					if (!accountButtonLabel) return;
					accountButtonLabel.textContent = loggedAccount?.name
						? loggedAccount.name
						: 'Entrar';
				};

				const openAccountPanel = () => {
					if (!accountPanel) return;
					accountPanel.hidden = false;
					document.body.classList.add('shop-modal-open');
				};

				const closeAccountPanel = () => {
					if (!accountPanel) return;
					accountPanel.hidden = true;
					if (accountModal?.hidden && termsModal?.hidden && pixModal?.hidden && loginModal?.hidden && dashboardModal?.hidden) {
						document.body.classList.remove('shop-modal-open');
					}
				};

				const setAccountTab = (target) => {
					accountTabs.forEach((tab) => {
						tab.classList.toggle('is-active', tab.getAttribute('data-account-tab') === target);
					});
					accountViews.forEach((view) => {
						const isActive = view.getAttribute('data-account-view') === target;
						view.classList.toggle('is-active', isActive);
						view.hidden = !isActive;
					});
				};

				const filterProducts = () => {
					const search = String(productSearch?.value || '').trim().toLowerCase();
					productCards.forEach((card) => {
						const haystack = String(card.getAttribute('data-search') || '').toLowerCase();
						card.hidden = Boolean(search) && !haystack.includes(search);
					});
					categoryBlocks.forEach((section) => {
						const visibleCards = section.querySelectorAll('[data-product-card]:not([hidden])');
						section.hidden = Boolean(search) && visibleCards.length === 0;
					});
				};

				const revealProducts = () => {
					if (!('IntersectionObserver' in window)) {
						productCards.forEach((card) => card.classList.add('is-visible'));
						return;
					}

					const observer = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					}, { threshold: 0.14 });

					productCards.forEach((card, index) => {
						card.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 70}ms`);
						observer.observe(card);
					});
				};

				const toggleSearch = () => {
					if (!searchBox) return;
					const shouldOpen = searchBox.hidden;
					searchBox.hidden = !shouldOpen;
					if (shouldOpen) {
						window.setTimeout(() => productSearch?.focus(), 80);
					} else if (productSearch) {
						productSearch.value = '';
						filterProducts();
					}
				};

				const renderDashboard = (data) => {
					loggedAccount = data.account || null;
					updateAccountButton();

					if (!loggedAccount) return;

					if (dashboardName) dashboardName.textContent = loggedAccount.name || 'Jogador';
					if (dashboardId) dashboardId.textContent = `ID #${loggedAccount.idPublico || '---'}`;
					if (dashboardSkin) {
						dashboardSkin.src = loggedAccount.skinImageUrl || `https://assets.open.mp/assets/images/skins/${loggedAccount.skin || 0}.png`;
						dashboardSkin.hidden = false;
					}
					if (dashboardMember) dashboardMember.textContent = formatDate(loggedAccount.memberSince);
					if (dashboardMoney) dashboardMoney.textContent = formatMoney(loggedAccount.money);
					if (dashboardLevel) dashboardLevel.textContent = loggedAccount.level ?? 0;
					if (dashboardSlots) dashboardSlots.textContent = loggedAccount.garageSlots ?? 0;

					const vehicles = Array.isArray(data.vehicles) ? data.vehicles : [];
					if (dashboardVehicles) {
						dashboardVehicles.innerHTML = vehicles.length
							? vehicles.map((vehicle) => `
								<article class="shop-vehicle-card">
									${vehicle.imageUrl ? `<img src="${escapeHtml(vehicle.imageUrl)}" alt="${escapeHtml(vehicle.name || `Veículo ${vehicle.model}`)}" loading="lazy" onerror="this.hidden=true" />` : ''}
									<div>
										<strong>${escapeHtml(vehicle.name || `Modelo ${vehicle.model || '?'}`)}</strong>
										<span>Slot ${escapeHtml(vehicle.slot ?? '--')} · Modelo ${escapeHtml(vehicle.model ?? '--')}</span>
									</div>
								</article>
							`).join('')
							: '<p class="shop-empty">Nenhum veículo encontrado nessa conta ainda.</p>';
					}

					const orders = Array.isArray(data.orders) ? data.orders : [];
					if (dashboardOrders) {
						dashboardOrders.innerHTML = orders.length
							? orders.map((order) => `
								<article class="shop-order-item">
									<div>
										<strong>${escapeHtml(order.productName || 'Pedido da loja')}</strong>
										<span>#${escapeHtml(order.orderId)} · ${escapeHtml(formatDate(order.createdAt))}</span>
									</div>
									<em>${escapeHtml(formatOrderStatus(order.status, order.deliveryStatus))}</em>
								</article>
							`).join('')
							: '<p class="shop-empty">Nenhum pedido encontrado ainda.</p>';
					}

					setDashboardState('Painel atualizado.', 'success');
				};

				const loadDashboard = async ({ silent = false } = {}) => {
					if (!apiBase) return null;
					if (!silent) setDashboardState('Carregando painel...', 'pending');

					try {
						const response = await fetch(`${apiBase}/api/me`, {
							headers: fetchHeaders,
							credentials: 'include'
						});
						const data = await response.json().catch(() => ({}));

						if (!response.ok) {
							throw new Error(data.error || 'Sessão não encontrada.');
						}

						renderDashboard(data);
						return data;
					} catch (error) {
						loggedAccount = null;
						updateAccountButton();
						if (!silent) setDashboardState(error.message || 'Não foi possível carregar o painel.', 'error');
						return null;
					}
				};

				const loginAccount = async () => {
					const accountId = Number(String(loginId?.value || '').trim());
					const password = String(loginPassword?.value || '');

					if (!Number.isInteger(accountId) || accountId <= 0) {
						setLoginState('Digite um ID válido.', 'error');
						loginId?.focus();
						return;
					}

					if (!password) {
						setLoginState('Digite a senha da conta.', 'error');
						loginPassword?.focus();
						return;
					}

					if (loginLoading) loginLoading.hidden = false;
					if (loginSubmit) loginSubmit.disabled = true;
					setLoginState('Verificando ID e senha...', 'pending');

					try {
						const response = await fetch(`${apiBase}/api/auth/login`, {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								...fetchHeaders
							},
							credentials: 'include',
							body: JSON.stringify({
								accountId,
								password,
								captchaToken: getCaptchaToken('login')
							})
						});
						const data = await response.json().catch(() => ({}));

						if (!response.ok) {
							throw new Error(data.error || 'Não foi possível entrar.');
						}

						renderDashboard(data);
						setLoginState('Login confirmado.', 'success');
						closeModal(loginModal);
						openAccountPanel();
					} catch (error) {
						resetCaptcha('login');
						setLoginState(error.message || 'ID ou senha incorretos.', 'error');
					} finally {
						if (loginLoading) loginLoading.hidden = true;
						if (loginSubmit) loginSubmit.disabled = false;
					}
				};

				const logoutAccount = async () => {
					try {
						await fetch(`${apiBase}/api/auth/logout`, {
							method: 'POST',
							headers: fetchHeaders,
							credentials: 'include'
						});
					} catch {
						// Se a API estiver fora, ainda limpamos a interface local.
					}

					loggedAccount = null;
					updateAccountButton();
					closeAccountPanel();
					openModal(loginModal);
					renderCaptcha('login');
					setLoginState('Você saiu da conta neste navegador.', 'success');
				};

				const prepareLoggedCheckout = () => {
					selectedAccount = {
						accountId: loggedAccount.idPublico,
						name: loggedAccount.name,
						skin: loggedAccount.skin,
						level: loggedAccount.level
					};
					if (accountInput) {
						accountInput.value = String(loggedAccount.idPublico || '');
						accountInput.disabled = true;
					}
					if (accountProduct) accountProduct.textContent = selectedProduct?.name || 'Produto selecionado';
					if (accountName) accountName.textContent = loggedAccount.name || 'Jogador';
					if (accountSkin) accountSkin.textContent = `#${loggedAccount.skin ?? '-'}`;
					if (accountSkinImage) {
						accountSkinImage.src = loggedAccount.skinImageUrl || `https://assets.open.mp/assets/images/skins/${loggedAccount.skin || 0}.png`;
						accountSkinImage.hidden = false;
					}
					if (accountLevel) accountLevel.textContent = loggedAccount.level ?? 'Não disponível';
					if (accountResult) accountResult.hidden = false;
					if (accountConfirm) accountConfirm.hidden = false;
					if (accountChange) accountChange.hidden = false;
					setAccountState('Você está comprando para a conta logada. Confira antes de continuar.', 'success');
				};

				const resetTermsModal = () => {
					if (termsSummary) {
						termsSummary.textContent = `${selectedProduct?.name || 'Produto selecionado'} para o ID ${selectedAccount?.accountId || '--'}`;
					}
					if (termsCheck) termsCheck.checked = false;
					if (termsConfirm) termsConfirm.disabled = true;
					if (checkoutTurnstile) checkoutTurnstile.hidden = Boolean(loggedAccount);
					resetCaptcha('checkout');
					setTermsState(loggedAccount
						? 'Confira os termos e confirme para gerar o Pix.'
						: 'Confirme os termos e o captcha para gerar o Pix.', 'info');
				};

				const openTermsModal = () => {
					if (!selectedProduct || !selectedAccount) return;
					closeModal(accountModal);
					resetTermsModal();
					openModal(termsModal);
					if (!loggedAccount) renderCaptcha('checkout');
				};

				const renderPixPayment = (data) => {
					if (modalLoading) modalLoading.hidden = true;
					if (modalContent) modalContent.hidden = false;
					if (modalQr && data.qrCodeBase64) {
						modalQr.src = `data:image/png;base64,${data.qrCodeBase64}`;
					}
					if (modalCode) {
						modalCode.value = data.qrCode || '';
					}
					if (modalOpen && data.ticketUrl) {
						modalOpen.href = data.ticketUrl;
						modalOpen.hidden = false;
					}
					setPixState('Pix gerado. Após pagar, aguarde a confirmação automática.', 'pending');
				};

				const showPaidFlow = () => {
					if (modalContent) modalContent.hidden = true;
					if (modalLoading) modalLoading.hidden = true;
					if (modalSuccess) modalSuccess.hidden = false;
					if (deliveryBar) deliveryBar.style.width = '34%';
					deliverySteps.forEach((step, index) => step.classList.toggle('is-active', index === 0));
					setPixState('Pagamento aprovado. Processando pedido...', 'success');

					deliveryFlowTimers.forEach((timer) => window.clearTimeout(timer));
					deliveryFlowTimers = [
						window.setTimeout(() => {
							if (deliveryBar) deliveryBar.style.width = '67%';
							deliverySteps.forEach((step, index) => step.classList.toggle('is-active', index <= 1));
							setPixState('Pedido em processamento. Preparando entrega...', 'pending');
						}, 900),
						window.setTimeout(() => {
							if (deliveryBar) deliveryBar.style.width = '100%';
							deliverySteps.forEach((step) => step.classList.add('is-active'));
							setPixState('Pedido processado e entregue na conta.', 'success');
							setStatus('Compra aprovada e entregue na conta.', 'success');
							if (loggedAccount) loadDashboard({ silent: true });
						}, 1900)
					];
				};

				const pollOrderStatus = (orderId) => {
					if (pollTimer) window.clearInterval(pollTimer);

					const check = async () => {
						try {
							const response = await fetch(`${apiBase}/api/orders/${orderId}`, {
								headers: fetchHeaders,
								credentials: 'include'
							});
							const data = await response.json().catch(() => ({}));

							if (!response.ok) {
								throw new Error(data.error || 'Não foi possível consultar o pedido.');
							}

							if (data.status === 'entregue' || data.deliveryStatus === 'entregue') {
								showPaidFlow();
								if (pollTimer) window.clearInterval(pollTimer);
								pollTimer = null;
								return;
							}

							if (data.status === 'erro' || data.deliveryStatus === 'erro') {
								setPixState(data.error || 'Pagamento recebido, mas houve erro na entrega. Chame o suporte.', 'error');
								setStatus('Pagamento recebido, mas a entrega precisa de suporte.', 'error');
								if (pollTimer) window.clearInterval(pollTimer);
								pollTimer = null;
								return;
							}

							if (data.status === 'pago') {
								showPaidFlow();
								if (pollTimer) window.clearInterval(pollTimer);
								pollTimer = null;
								return;
							}

							setPixState('Aguardando confirmação do Pix...', 'pending');
						} catch (error) {
							setPixState(error.message || 'Falha ao consultar status. Não feche esta janela ainda.', 'error');
						}
					};

					check();
					pollTimer = window.setInterval(check, 5000);
				};

				const verifyAccount = async () => {
					const accountId = Number(String(accountInput?.value || '').trim());
					if (!Number.isInteger(accountId) || accountId <= 0) {
						setAccountState('Digite um ID de conta válido.', 'error');
						accountInput?.focus();
						return;
					}

					if (accountLoading) accountLoading.hidden = false;
					if (accountResult) accountResult.hidden = true;
					if (accountConfirm) accountConfirm.hidden = true;
					if (accountChange) accountChange.hidden = true;
					if (accountInput) accountInput.disabled = true;
					setAccountState('Verificando conta...', 'pending');

					try {
						const response = await fetch(`${apiBase}/api/accounts/${accountId}`, {
							headers: fetchHeaders,
							credentials: 'include'
						});
						const data = await response.json().catch(() => ({}));

						if (!response.ok) {
							throw new Error(data.error || 'Conta não encontrada.');
						}

						selectedAccount = data;
						if (accountName) accountName.textContent = data.name || 'Jogador';
						if (accountSkin) accountSkin.textContent = `#${data.skin ?? '-'}`;
						if (accountSkinImage) {
							const skin = Number.isInteger(Number(data.skin)) ? Number(data.skin) : 0;
							accountSkinImage.src = `https://assets.open.mp/assets/images/skins/${skin}.png`;
							accountSkinImage.hidden = false;
						}
						if (accountLevel) accountLevel.textContent = data.level ?? 'Não disponível';
						if (accountResult) accountResult.hidden = false;
						if (accountConfirm) accountConfirm.hidden = false;
						if (accountChange) accountChange.hidden = false;
						setAccountState('Confira se essa é sua conta antes de continuar.', 'success');
					} catch (error) {
						selectedAccount = null;
						setAccountState(error.message || 'Não foi possível verificar a conta.', 'error');
						if (accountInput) accountInput.disabled = false;
					} finally {
						if (accountLoading) accountLoading.hidden = true;
					}
				};

				const startPixPayment = async () => {
					if (!selectedProduct || !selectedAccount) return;

					closeModal(accountModal);
					closeModal(termsModal);
					resetPixModal(selectedProduct.name, selectedAccount.accountId);
					openModal(pixModal);
					setStatus(`Gerando Pix para ${selectedAccount.name || selectedAccount.accountId}...`, 'info');

					try {
						const captchaToken = loggedAccount ? '' : getCaptchaToken('checkout');
						const response = await fetch(`${apiBase}/api/pix`, {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								...fetchHeaders
							},
							credentials: 'include',
							body: JSON.stringify({
								productId: selectedProduct.id,
								accountId: selectedAccount.accountId,
								termsAccepted: true,
								termsVersion,
								captchaToken
							})
						});

						const data = await response.json().catch(() => ({}));

						if (!response.ok) {
							throw new Error(data.error || data.details || 'Não foi possível gerar o Pix.');
						}

						if (!data.qrCode && !data.ticketUrl) {
							throw new Error('Mercado Pago não retornou o Pix.');
						}

						renderPixPayment(data);
						pollOrderStatus(data.orderId);
						setStatus(`Pix gerado para ${data.accountName || selectedAccount.name}. Aguardando pagamento.`, 'success');
					} catch (error) {
						resetCaptcha('checkout');
						setStatus(error.message || 'Erro ao gerar Pix. Chame o suporte.', 'error');
						setPixState(error.message || 'Erro ao gerar Pix. Chame o suporte.', 'error');
						if (modalLoading) modalLoading.hidden = true;
					}
				};

				document.querySelectorAll('[data-pix-close]').forEach((button) => {
					button.addEventListener('click', closePixModal);
				});

				document.querySelectorAll('[data-account-close]').forEach((button) => {
					button.addEventListener('click', () => closeModal(accountModal));
				});

				document.querySelectorAll('[data-terms-close]').forEach((button) => {
					button.addEventListener('click', () => closeModal(termsModal));
				});

				document.querySelectorAll('[data-login-close]').forEach((button) => {
					button.addEventListener('click', () => closeModal(loginModal));
				});

				document.querySelectorAll('[data-dashboard-close]').forEach((button) => {
					button.addEventListener('click', () => closeModal(dashboardModal));
				});

				document.querySelectorAll('[data-account-panel-close]').forEach((button) => {
					button.addEventListener('click', closeAccountPanel);
				});

				openLoginButton?.addEventListener('click', async () => {
					if (loggedAccount) {
						const data = await loadDashboard({ silent: false });
						if (data) {
							openAccountPanel();
						} else {
							openModal(loginModal);
							renderCaptcha('login');
						}
					} else {
						openModal(loginModal);
						renderCaptcha('login');
						window.setTimeout(() => loginId?.focus(), 80);
					}
				});

				loginSubmit?.addEventListener('click', loginAccount);
				loginId?.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') loginAccount();
				});
				loginPassword?.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') loginAccount();
				});
				loginSkip?.addEventListener('click', () => {
					sessionStorage.setItem('lojaLoginSkipped', '1');
					closeModal(loginModal);
				});
				dashboardRefresh?.addEventListener('click', () => loadDashboard({ silent: false }));
				logoutButton?.addEventListener('click', logoutAccount);
				searchToggle?.addEventListener('click', toggleSearch);
				productSearch?.addEventListener('input', filterProducts);
				productSearch?.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') toggleSearch();
				});
				accountTabs.forEach((tab) => {
					tab.addEventListener('click', () => setAccountTab(tab.getAttribute('data-account-tab') || 'resumo'));
				});

				accountVerify?.addEventListener('click', verifyAccount);
				accountInput?.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') verifyAccount();
				});
				accountConfirm?.addEventListener('click', openTermsModal);
				accountChange?.addEventListener('click', () => {
					if (accountInput) {
						accountInput.disabled = false;
						accountInput.focus();
					}
					if (accountResult) accountResult.hidden = true;
					if (accountConfirm) accountConfirm.hidden = true;
					if (accountChange) accountChange.hidden = true;
					selectedAccount = null;
					setAccountState('Digite o ID correto e verifique novamente.', 'info');
				});
				termsCheck?.addEventListener('change', () => {
					if (termsConfirm) termsConfirm.disabled = !termsCheck.checked;
					setTermsState(termsCheck.checked
						? 'Termos aceitos. Gere o Pix para continuar.'
						: 'Marque o aceite para continuar.', termsCheck.checked ? 'success' : 'info');
				});
				termsBack?.addEventListener('click', () => {
					closeModal(termsModal);
					openModal(accountModal);
				});
				termsConfirm?.addEventListener('click', () => {
					if (!termsCheck?.checked) {
						setTermsState('VocÃª precisa aceitar os termos para continuar.', 'error');
						return;
					}
					startPixPayment();
				});

				modalCopy?.addEventListener('click', async () => {
					const code = modalCode?.value || '';
					if (!code) return;

					try {
						await navigator.clipboard.writeText(code);
						setPixState('Código Pix copiado. Agora é só colar no app do banco.', 'success');
					} catch {
						modalCode?.select();
						setPixState('Selecione e copie o código Pix manualmente.', 'pending');
					}
				});

				buyButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const productId = button.getAttribute('data-product-id');
						const productName = button.getAttribute('data-product-name') || 'produto';

						if (!apiBase || !productId) {
							setStatus('Checkout ainda não configurado para este produto.', 'error');
							return;
						}

						selectedProduct = {
							id: productId,
							name: productName
						};
						resetAccountModal();
						if (loggedAccount) {
							prepareLoggedCheckout();
						}
						openModal(accountModal);
						if (loggedAccount) {
							setStatus(`Confira sua conta para ${productName}.`, 'info');
						} else {
							setStatus(`Informe o ID da conta para ${productName}.`, 'info');
							window.setTimeout(() => accountInput?.focus(), 80);
						}
					});
				});

				loadDashboard({ silent: true });
				revealProducts();
			})();
		</script>
	</body>
</html>

