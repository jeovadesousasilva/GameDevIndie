	.shop-support h2 {
		margin-top: 4px;
		font-size: 1.35rem;
		color: var(--shop-white);
	}

	.shop-support-links {
		gap: 10px;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.shop-support-links a {
		min-height: 42px;
		padding: 0 16px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.08);
		color: var(--shop-white);
	}

	.shop-account-panel {
		position: fixed;
		inset: 0;
		z-index: 76;
		display: flex;
		justify-content: flex-end;
		padding: 0;
		color: var(--shop-navy);
	}

	.shop-account-panel[hidden],
	.shop-account-view[hidden] {
		display: none;
	}

	.shop-account-page-backdrop {
		position: absolute;
		inset: 0;
		border: 0;
		background: rgba(0, 0, 0, 0.66);
		backdrop-filter: blur(8px);
		cursor: pointer;
	}

	.shop-account-panel > .shop-container {
		position: relative;
		z-index: 1;
		width: min(620px, 100%);
		height: 100%;
		margin: 0;
	}

	.shop-account-shell {
		height: 100%;
		overflow-y: auto;
		padding: clamp(18px, 3vw, 28px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-right: 0;
		border-radius: 32px 0 0 32px;
		background:
			radial-gradient(circle at top right, rgba(255, 201, 40, 0.2), transparent 30%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(240, 246, 255, 0.98) 100%);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		color: var(--shop-navy);
		animation: shop-account-slide-in 260ms ease both;
	}

	.shop-account-back {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		gap: 9px;
		margin-bottom: 18px;
		padding: 0 16px;
		border: 0;
		border-radius: var(--shop-radius-pill);
		color: var(--shop-navy);
		background: var(--shop-yellow);
		font: inherit;
		font-weight: 900;
		cursor: pointer;
	}

	.shop-account-back span {
		font-size: 1.12rem;
		line-height: 1;
	}

	@keyframes shop-account-slide-in {
		from {
			transform: translateX(26px);
			opacity: 0;
		}

		to {
			transform: translateX(0);
			opacity: 1;
		}
	}

	.shop-account-cover {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.shop-account-cover h2 {
		margin-top: 6px;
		color: var(--shop-navy);
	}

	.shop-account-cover > div:last-child > span {
		display: inline-flex;
		margin-top: 8px;
		padding: 6px 10px;
		border-radius: var(--shop-radius-pill);
		color: var(--shop-blue-dark);
		background: #eef3ff;
		font-weight: 900;
	}

	.shop-account-tabs {
		display: flex;
		gap: 10px;
		overflow-x: auto;
		margin-top: 22px;
		padding: 8px;
		border-radius: 20px;
		background: #eef3ff;
	}

	.shop-account-tabs button {
		flex: 0 0 auto;
		min-height: 42px;
		padding: 0 18px;
		border: 0;
		border-radius: var(--shop-radius-pill);
		color: var(--shop-blue-dark);
		background: transparent;
		font: inherit;
		font-weight: 900;
		cursor: pointer;
	}

	.shop-account-tabs button.is-active {
		color: var(--shop-navy);
		background: var(--shop-yellow);
		box-shadow: 0 12px 24px rgba(255, 201, 40, 0.24);
	}

	.shop-account-view {
		margin-top: 18px;
	}

	.shop-products {
		padding: clamp(56px, 8vw, 96px) 0 80px;
	}

	.shop-section-head {
		display: grid;
		gap: 8px;
	}

	.shop-section-head h2 {
		color: var(--shop-white);
		font-size: clamp(3.2rem, 7vw, 5.4rem);
		letter-spacing: -0.06em;
	}

	.shop-categories {
		position: sticky;
		top: 92px;
		z-index: 10;
		gap: 10px;
		overflow-x: auto;
		margin: 22px 0 62px;
		padding: 0 0 10px;
		border: 0;
		border-radius: 0;
		background: transparent;
		backdrop-filter: blur(14px);
		box-shadow: none;
	}

	.shop-categories a {
		flex: 0 0 auto;
		min-height: 54px;
		gap: 8px;
		padding: 0 22px;
		color: rgba(255, 255, 255, 0.82);
		background: rgba(255, 255, 255, 0.075);
		border: 1px solid rgba(255, 255, 255, 0.16);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.shop-categories a:first-child,
	.shop-categories a:hover {
		border-color: rgba(255, 201, 40, 0.62);
		color: var(--shop-white);
		background: rgba(255, 201, 40, 0.12);
	}

	.shop-category-block {
		scroll-margin-top: 178px;
		margin-top: 74px;
	}

	.shop-category-title {
		gap: 10px;
		margin-bottom: 28px;
	}

	.shop-category-title h3 {
		color: var(--shop-white);
	}

	.shop-category-title span {
		display: grid;
		width: auto;
		min-width: 92px;
		height: 48px;
		padding: 0 18px;
		place-items: center;
		border: 2px solid var(--shop-yellow);
		border-radius: 12px;
		background: rgba(255, 201, 40, 0.08);
		color: var(--shop-white);
		font-size: 1.1rem;
	}

	.shop-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 18px;
	}

	.shop-product {
		display: flex;
		min-height: 410px;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		padding: 0;
		border: 1px solid var(--shop-card-line);
		border-radius: 12px;
		color: var(--shop-white);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.01) 100%),
			var(--shop-card);
		box-shadow: 0 20px 38px rgba(0, 0, 0, 0.28);
		opacity: 0;
		transform: translateY(18px) scale(0.98);
		transition: transform 170ms ease, border-color 170ms ease, box-shadow 170ms ease;
	}

	.shop-product.is-visible {
		opacity: 1;
		transform: translateY(0) scale(1);
		transition:
			opacity 520ms ease var(--reveal-delay, 0ms),
			transform 520ms ease var(--reveal-delay, 0ms),
			border-color 170ms ease,
			box-shadow 170ms ease;
	}

	.shop-product:hover {
		transform: translateY(-3px);
		border-color: rgba(255, 201, 40, 0.46);
		box-shadow: 0 26px 52px rgba(0, 0, 0, 0.36);
	}

	.shop-product-featured {
		border-color: rgba(255, 201, 40, 0.5);
		background:
			radial-gradient(circle at 70% 12%, rgba(255, 201, 40, 0.12), transparent 34%),
			var(--shop-card);
	}

	.shop-product-top {
		justify-content: space-between;
		align-items: flex-start;
		gap: 12px;
	}

	.shop-product-media {
		position: relative;
		display: grid;
		min-height: 240px;
		place-items: center;
		overflow: hidden;
		border-bottom: 1px solid var(--shop-card-line);
		background:
			radial-gradient(circle at 50% 44%, rgba(255, 201, 40, 0.2), transparent 34%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.01));
	}

	.shop-product-media::before {
		content: '';
		position: absolute;
		inset: 18px;
		border-radius: 22px;
		background:
			linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
		background-size: 24px 24px;
		mask-image: radial-gradient(circle, black 38%, transparent 70%);
	}

	.shop-product-visual {
		position: relative;
		width: 174px;
		height: 174px;
		display: grid;
		place-items: center;
		transform: none;
	}

	.shop-product-visual::before,
	.shop-product-visual::after {
		content: '';
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
	}

	.shop-product-visual::before {
		top: 18px;
		width: 138px;
		height: 138px;
		border: 1px solid rgba(255, 201, 40, 0.38);
		border-radius: 36px;
		background:
			linear-gradient(135deg, rgba(255, 201, 40, 0.28), rgba(255, 255, 255, 0.055)),
			#101115;
		box-shadow:
			0 24px 44px rgba(0, 0, 0, 0.4),
			inset 0 1px 0 rgba(255, 255, 255, 0.12);
	}

	.shop-product-visual::after {
		top: 38px;
		width: 92px;
		height: 92px;
		border-radius: 28px;
		background:
			radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.55), transparent 18%),
			linear-gradient(135deg, #ffe083, var(--shop-yellow));
		box-shadow: 0 14px 24px rgba(255, 201, 40, 0.2);
	}

	.shop-product-icon {
		position: relative;
		z-index: 2;
		display: grid;
		width: 88px;
		height: 88px;
		padding: 0 8px;
		place-items: center;
		border-radius: 26px;
		background: rgba(8, 9, 12, 0.94);
		color: #090a0d;
		font-family: 'Syne', sans-serif;
		font-size: 1.5rem;
		font-weight: 900;
		color: var(--shop-yellow);
		line-height: 0.96;
		text-align: center;
		box-shadow: inset 0 0 0 1px rgba(255, 201, 40, 0.28), 0 16px 34px rgba(0, 0, 0, 0.28);
	}

	.shop-product-compact-icon .shop-product-icon {
		font-size: 1.22rem;
		letter-spacing: -0.04em;
	}

	.shop-product-vips .shop-product-visual::before,
	.shop-product-ids .shop-product-visual::before,
	.shop-product-inventario .shop-product-visual::before {
		border-color: rgba(255, 255, 255, 0.2);
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 201, 40, 0.18)),
			#111216;
	}

	.shop-product-vips .shop-product-visual::after,
	.shop-product-ids .shop-product-visual::after,
	.shop-product-inventario .shop-product-visual::after {
		background:
			radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.4), transparent 18%),
			linear-gradient(135deg, #2c88ff, #8ce3ff);
	}

	.shop-product-garagem .shop-product-visual::before {
		border-color: rgba(50, 120, 255, 0.42);
		background:
			linear-gradient(135deg, rgba(20, 88, 255, 0.34), rgba(255, 201, 40, 0.12)),
			#101115;
	}

	.shop-product-garagem .shop-product-visual::after {
		background:
			radial-gradient(circle at 28% 22%, rgba(255, 255, 255, 0.48), transparent 18%),
			linear-gradient(135deg, #1458ff, #6fc1ff);
	}

	.shop-product-body {
		display: grid;
		gap: 10px;
		padding: 18px;
	}

	.shop-badge {
		flex: 0 0 auto;
		padding: 8px 10px;
		border-radius: var(--shop-radius-pill);
		color: var(--shop-yellow);
		background: rgba(255, 201, 40, 0.1);
		border: 1px solid rgba(255, 201, 40, 0.18);
		font-size: 0.72rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.shop-product h4 {
		margin-top: 0;
		color: var(--shop-white);
		font-size: 1.15rem;
		line-height: 1.12;
	}

	.shop-product p {
		margin-top: 0;
		color: rgba(255, 255, 255, 0.74);
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.45;
	}

	.shop-product-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-width: 0;
		color: rgba(255, 255, 255, 0.68);
		font-size: 0.92rem;
		font-weight: 800;
	}

	.shop-product-meta span,
	.shop-buy-button,
	.shop-product-disabled,
	.shop-product-bottom a {
		white-space: nowrap;
	}

	.shop-product-meta span {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.shop-product-meta em {
		display: grid;
		width: auto;
		min-width: 36px;
		height: 36px;
		padding: 0 7px;
		place-items: center;
		border: 1px solid rgba(61, 221, 203, 0.45);
		border-radius: 9px;
		color: #6ff4e3;
		background: rgba(28, 170, 154, 0.28);
		font-size: 0.72rem;
		font-style: normal;
		text-transform: uppercase;
	}

	.shop-product-bottom {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
		display: grid;
		gap: 12px;
	}

	.shop-product-bottom strong {
		font-family: 'Syne', sans-serif;
		font-size: 1.48rem;
		line-height: 1;
		color: var(--shop-white);
	}

	.shop-product-bottom a,
	.shop-buy-button,
	.shop-product-disabled {
		width: 100%;
		min-height: 46px;
		gap: 10px;
		padding: 0 16px;
		border: 0;
		font: inherit;
		font-weight: 900;
		border-radius: var(--shop-radius-pill);
		color: var(--shop-navy);
		background: var(--shop-yellow);
	}

	.shop-buy-button {
		cursor: pointer;
	}

	.shop-buy-button:disabled {
		cursor: wait;
		opacity: 0.72;
	}

	.shop-product-disabled {
		cursor: not-allowed;
		color: rgba(255, 255, 255, 0.42);
		background: rgba(255, 255, 255, 0.1);
	}

	.shop-product[hidden],
	.shop-category-block[hidden] {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.shop-product {
			opacity: 1;
			transform: none;
		}
	}

	.shop-note {
		padding: 16px 0 64px;
	}

	.shop-note-card {
		gap: 18px;
		align-items: flex-start;
		padding: 22px;
		border: 1px dashed rgba(20, 88, 255, 0.28);
		border-radius: var(--shop-radius-lg);
		background: rgba(11, 24, 48, 0.78);
	}

	.shop-note-card > span {
		display: grid;
		width: 48px;
		height: 48px;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 16px;
		background: var(--shop-yellow);
		font-size: 1.45rem;
	}

	.shop-note-card h2 {
		font-size: 1.4rem;
		color: var(--shop-white);
	}

	.shop-note-card p {
		margin-top: 8px;
		color: #b8c4d8;
	}

	.shop-modal-open {
		overflow: hidden;
	}

	.shop-pix-modal[hidden],
	.shop-account-modal[hidden],
	.shop-login-modal[hidden],
	.shop-dashboard-modal[hidden],
	.shop-terms-modal[hidden] {
		display: none;
	}

	.shop-pix-modal,
	.shop-account-modal,
	.shop-login-modal,
	.shop-dashboard-modal,
	.shop-terms-modal {
		position: fixed;
		inset: 0;
		z-index: 80;
		display: grid;
		place-items: center;
		padding: 22px;
	}

	.shop-pix-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(2, 6, 18, 0.78);
		backdrop-filter: blur(10px);
	}

	.shop-pix-dialog {
		position: relative;
		z-index: 1;
		width: min(520px, 100%);
		max-height: calc(100vh - 44px);
		overflow-y: auto;
		padding: 26px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 28px;
		color: var(--shop-navy);
		background: var(--shop-white);
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.36);
	}

	.shop-pix-dialog h2 {
		margin-top: 6px;
		color: var(--shop-navy);
	}

	.shop-login-dialog {
		width: min(500px, 100%);
	}

	.shop-login-text {
		margin-top: 10px;
		font-weight: 800;
	}

	.shop-login-form {
		display: grid;
		gap: 10px;
		margin-top: 18px;
	}

	.shop-login-form label {
		color: var(--shop-navy);
		font-weight: 900;
	}

	.shop-login-form input {
		width: 100%;
		min-height: 48px;
		padding: 0 14px;
		border: 1px solid var(--shop-line);
		border-radius: 16px;
		color: var(--shop-navy);
		background: #f8fbff;
		font: inherit;
		font-weight: 800;
		outline: none;
	}

	.shop-login-form input:focus {
		border-color: rgba(20, 88, 255, 0.45);
		box-shadow: 0 0 0 4px rgba(20, 88, 255, 0.1);
	}

	.shop-captcha-box {
		display: grid;
		min-height: 72px;
		place-items: center;
		padding: 10px;
		border: 1px dashed rgba(20, 88, 255, 0.28);
		border-radius: 18px;
		background: #f8fbff;
		color: var(--shop-muted);
		font-size: 0.82rem;
		font-weight: 900;
		text-align: center;
	}

	.shop-captcha-box[hidden] {
		display: none;
	}

	.shop-terms-dialog {
		width: min(560px, 100%);
	}

	.shop-terms-card {
		display: grid;
		gap: 12px;
		margin-top: 18px;
		padding: 18px;
		border: 1px solid var(--shop-line);
		border-radius: 20px;
		background:
			radial-gradient(circle at top right, rgba(255, 201, 40, 0.18), transparent 34%),
			#f8fbff;
	}

	.shop-terms-card ul {
		display: grid;
		gap: 10px;
		padding-left: 18px;
		color: var(--shop-navy);
		font-weight: 800;
		line-height: 1.55;
	}

	.shop-terms-card a {
		width: fit-content;
		color: var(--shop-blue-dark);
		font-weight: 900;
	}

	.shop-terms-check {
		display: flex;
		gap: 12px;
		align-items: flex-start;
		margin: 16px 0 12px;
		color: var(--shop-navy);
		font-weight: 900;
		line-height: 1.45;
	}

	.shop-terms-check input {
		width: 20px;
		height: 20px;
		margin-top: 2px;
		accent-color: var(--shop-yellow);
		flex: 0 0 auto;
	}

	.shop-pix-copy:disabled,
	.shop-pix-open:disabled {
		opacity: 0.48;
		cursor: not-allowed;
		transform: none;
	}

	.shop-dashboard-dialog {
		position: relative;
		z-index: 1;
		width: min(940px, 100%);
		max-height: calc(100vh - 44px);
		overflow-y: auto;
		padding: clamp(22px, 4vw, 34px);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 30px;
		color: var(--shop-navy);
		background:
			radial-gradient(circle at top left, rgba(255, 201, 40, 0.24), transparent 28%),
			var(--shop-white);
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.36);
	}

	.shop-dashboard-head {
		display: flex;
		align-items: center;
		gap: 18px;
		padding-right: 46px;
	}

	.shop-dashboard-head h2 {
		margin-top: 4px;
		color: var(--shop-navy);
	}

	.shop-dashboard-head span {
		display: inline-flex;
		margin-top: 8px;
		padding: 6px 10px;
		border-radius: var(--shop-radius-pill);
		color: var(--shop-blue-dark);
		background: #eef3ff;
		font-weight: 900;
	}

	.shop-dashboard-skin {
		display: grid;
		width: 112px;
		height: 132px;
		flex: 0 0 auto;
		place-items: end center;
		overflow: hidden;
		border: 1px solid var(--shop-line);
		border-radius: 24px;
		background:
			radial-gradient(circle at 50% 18%, rgba(255, 201, 40, 0.45), transparent 34%),
			linear-gradient(180deg, #eef3ff 0%, #ffffff 100%);
	}

	.shop-dashboard-skin img {
		width: 84px;
		height: 124px;
		object-fit: contain;
		object-position: bottom center;
		filter: drop-shadow(0 12px 16px rgba(7, 20, 38, 0.22));
	}

	.shop-dashboard-stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		margin-top: 20px;
	}

	.shop-dashboard-stats article,
	.shop-vehicle-card,
	.shop-order-item {
		border: 1px solid var(--shop-line);
		border-radius: 20px;
		background: #f8fbff;
	}

	.shop-dashboard-stats article {
		padding: 14px;
	}

	.shop-dashboard-stats span,
	.shop-vehicle-card span,
	.shop-order-item span {
		display: block;
		color: var(--shop-muted);
		font-size: 0.78rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.shop-dashboard-stats strong {
		display: block;
		margin-top: 6px;
		color: var(--shop-navy);
		font-family: 'Syne', sans-serif;
		font-size: 1.25rem;
	}

	.shop-dashboard-section {
