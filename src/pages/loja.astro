---
import { withBase } from '../utils/paths';

const siteUrl = 'https://midnighttoronto.com.br';
const pagePath = 'loja/';
const canonicalUrl = `${siteUrl}${withBase(pagePath)}`;
const faviconHref = withBase('favicon.png');
const roleplayUrl = withBase('171-brasil-roleplay/');
const discordUrl = 'https://discord.gg/6GwbJRFhQU';
const studioAsset = withBase('midnight-toronto/assets');
const logoImage = `${studioAsset}/images/midnight-city/171-brasil-roleplay-logo-v3.png`;
const socialImage = `${siteUrl}${withBase('midnight-toronto/assets/images/midnight-city/171-brasil-roleplay-logo-v3.png')}`;

const categories = [
	{ id: 'moedas', label: 'Moedas', icon: '💰' },
	{ id: 'vips', label: 'VIPs', icon: '💎' },
	{ id: 'inventario', label: 'Inventário', icon: '🎒' },
	{ id: 'garagem', label: 'Garagem', icon: '🚗' },
	{ id: 'ids', label: 'IDs', icon: '🆔' }
];

const products = [
	{
		category: 'moedas',
		icon: '🪙',
		name: '10 mil moedas',
		description: 'Saldo inicial para comprar itens, veículos e recursos dentro do servidor.',
		price: 'R$ 10,00',
		badge: '10.000 moedas'
	},
	{
		category: 'moedas',
		icon: '💰',
		name: '25 mil moedas',
		description: 'Pacote equilibrado para começar com mais liberdade na cidade.',
		price: 'R$ 25,00',
		badge: '25.000 moedas',
		featured: true
	},
	{
		category: 'moedas',
		icon: '🏦',
		name: '50 mil moedas',
		description: 'Mais saldo para guardar, investir e aproveitar futuras novidades.',
		price: 'R$ 50,00',
		badge: '50.000 moedas'
	},
	{
		category: 'vips',
		icon: '💎',
		name: 'VIP Prata',
		description: 'Tag VIP, bônus de rotina e benefícios extras planejados para jogadores ativos.',
		price: 'R$ 15,00',
		badge: '30 dias'
	},
	{
		category: 'vips',
		icon: '👑',
		name: 'VIP Ouro',
		description: 'Plano com benefícios superiores, visual especial e vantagens de progresso.',
		price: 'R$ 25,00',
		badge: '30 dias',
		featured: true
	},
	{
		category: 'vips',
		icon: '✨',
		name: 'VIP Diamante',
		description: 'O pacote VIP mais completo para quem quer apoiar e jogar com estilo.',
		price: 'R$ 40,00',
		badge: '30 dias'
	},
	{
		category: 'inventario',
		icon: '🎒',
		name: '+1 página de inventário',
		description: 'Adiciona mais espaço para guardar itens importantes da sua conta.',
		price: 'R$ 8,00',
		badge: '+ slots'
	},
	{
		category: 'inventario',
		icon: '📦',
		name: '+3 páginas de inventário',
		description: 'Pacote maior para jogadores que gostam de carregar mais recursos.',
		price: 'R$ 20,00',
		badge: 'melhor custo'
	},
	{
		category: 'garagem',
		icon: '🚗',
		name: '+1 página de garagem',
		description: 'Libera mais espaço para guardar veículos na conta do jogador.',
		price: 'R$ 12,00',
		badge: '+ veículos'
	},
	{
		category: 'garagem',
		icon: '🏁',
		name: '+3 páginas de garagem',
		description: 'Mais slots para quem quer colecionar carros, motos e veículos especiais.',
		price: 'R$ 30,00',
		badge: 'garagem maior'
	},
	{
		category: 'ids',
		icon: '🆔',
		name: 'ID 3 dígitos',
		description: 'Reserva de ID especial com três dígitos para deixar a conta mais marcante.',
		price: 'R$ 20,00',
		badge: 'exclusivo'
	},
	{
		category: 'ids',
		icon: '⭐',
		name: 'ID 2 dígitos',
		description: 'ID curto e raro para jogadores que querem uma identificação premium.',
		price: 'R$ 40,00',
		badge: 'raro'
	},
	{
		category: 'ids',
		icon: '🔢',
		name: 'ID personalizado',
		description: 'Escolha um ID disponível e combine a reserva com a equipe do servidor.',
		price: 'R$ 60,00',
		badge: 'sob consulta'
	}
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Loja 171 Brasil Roleplay | Moedas, VIP, Garagem e IDs</title>
		<meta
			name="description"
			content="Loja da 171 Brasil Roleplay com moedas, VIPs, páginas de inventário, garagem e IDs especiais."
		/>
		<meta
			name="keywords"
			content="loja 171 brasil roleplay, moedas samp, vip samp, id samp, garagem samp, inventário samp"
		/>
		<meta name="author" content="Jeová de Sousa" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href={faviconHref} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content="Loja 171 Brasil Roleplay" />
		<meta
			property="og:description"
			content="Moedas, VIPs, páginas extras e IDs especiais para a 171 Brasil Roleplay."
		/>
		<meta property="og:image" content={socialImage} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content="Loja 171 Brasil Roleplay" />
		<meta
			property="twitter:description"
			content="Moedas, VIPs, páginas extras e IDs especiais para a 171 Brasil Roleplay."
		/>
		<meta property="twitter:image" content={socialImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="shop-page">
			<header class="shop-header">
				<div class="shop-container shop-header-inner">
					<a href={roleplayUrl} class="shop-brand">
						<span class="shop-logo">
							<img src={logoImage} alt="Logo da 171 Brasil Roleplay" />
						</span>
						<span>
							<strong>171 Brasil RP</strong>
							<small>Loja oficial</small>
						</span>
					</a>

					<nav class="shop-top-nav" aria-label="Navegação principal">
						<a href={roleplayUrl}>Início</a>
						<a href="#produtos">Produtos</a>
						<a href={discordUrl} target="_blank" rel="noreferrer" class="shop-discord">
							Suporte
						</a>
					</nav>
				</div>
			</header>

			<main>
				<section class="shop-hero">
					<div class="shop-container shop-hero-grid">
						<div class="shop-hero-card">
							<p class="shop-eyebrow">SA-MP Mobile</p>
							<h1>Loja 171 Brasil Roleplay</h1>
							<p>
								Compre moedas, VIPs, páginas extras e IDs especiais para deixar sua conta do
								jeito que você quer.
							</p>

							<div class="shop-hero-actions">
								<a href="#produtos" class="shop-button shop-button-primary">Ver produtos</a>
								<a href={discordUrl} target="_blank" rel="noreferrer" class="shop-button shop-button-light">
									Chamar suporte
								</a>
							</div>
						</div>

						<aside class="shop-account-card">
							<span class="shop-card-icon">🆔</span>
							<h2>Compra por ID da conta</h2>
							<p>
								Na versão final, o jogador informa o ID da conta no checkout e recebe o produto
								após a confirmação do pagamento.
							</p>
							<label for="account-preview">Prévia do campo de ID</label>
							<div class="shop-id-preview">
								<input id="account-preview" type="text" placeholder="Ex: 1024" />
								<button type="button">OK</button>
							</div>
						</aside>
					</div>
				</section>

				<section class="shop-support">
					<div class="shop-container shop-support-inner">
						<div>
							<p class="shop-section-label">Atendimento</p>
							<h2>Canais de suporte</h2>
						</div>
						<div class="shop-support-links">
							<a href={discordUrl} target="_blank" rel="noreferrer">Discord</a>
							<a href="#produtos">Catálogo</a>
							<a href={roleplayUrl}>Página do servidor</a>
						</div>
					</div>
				</section>

				<section id="produtos" class="shop-products">
					<div class="shop-container">
						<div class="shop-section-head">
							<p class="shop-section-label">Categorias</p>
							<h2>Escolha seu produto</h2>
						</div>

						<div class="shop-categories" aria-label="Categorias da loja">
							{categories.map((category) => (
								<a href={`#${category.id}`}>
									<span>{category.icon}</span>
									{category.label}
								</a>
							))}
						</div>

						{categories.map((category) => (
							<section id={category.id} class="shop-category-block" aria-labelledby={`${category.id}-title`}>
								<div class="shop-category-title">
									<span>{category.icon}</span>
									<h3 id={`${category.id}-title`}>{category.label}</h3>
								</div>

								<div class="shop-grid">
									{products
										.filter((product) => product.category === category.id)
										.map((product) => (
											<article class:list={['shop-product', { 'shop-product-featured': product.featured }]}>
												<div class="shop-product-top">
													<span class="shop-product-icon">{product.icon}</span>
													<span class="shop-badge">{product.badge}</span>
												</div>
												<h4>{product.name}</h4>
												<p>{product.description}</p>
												<div class="shop-product-bottom">
													<strong>{product.price}</strong>
													<a
														href={discordUrl}
														target="_blank"
														rel="noreferrer"
														aria-label={`Comprar ${product.name}`}
													>
														Comprar
													</a>
												</div>
											</article>
										))}
								</div>
							</section>
						))}
					</div>
				</section>

				<section class="shop-note">
					<div class="shop-container shop-note-card">
						<span>⚠️</span>
						<div>
							<h2>Modelo visual da loja</h2>
							<p>
								Os produtos aparecem como se a loja já estivesse pronta. Antes das vendas reais,
								é só ligar o checkout, criar o sistema de moedas/VIP no gamemode e conectar a
								entrega automática com o MySQL.
							</p>
						</div>
					</div>
				</section>
			</main>

			<footer class="shop-footer">
				<div class="shop-container shop-footer-inner">
					<p>171 Brasil Roleplay © Loja do servidor</p>
					<a href={discordUrl} target="_blank" rel="noreferrer">Suporte no Discord</a>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--shop-navy: #071426;
		--shop-blue: #1458ff;
		--shop-blue-dark: #0c35a8;
		--shop-yellow: #ffc928;
		--shop-yellow-strong: #f5b800;
		--shop-white: #ffffff;
		--shop-ice: #f3f7ff;
		--shop-muted: #61708a;
		--shop-line: rgba(7, 20, 38, 0.12);
		--shop-shadow: 0 18px 42px rgba(7, 20, 38, 0.14);
		--shop-radius-lg: 26px;
		--shop-radius-md: 18px;
		--shop-radius-pill: 999px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		min-width: 320px;
		font-family: 'Manrope', sans-serif;
		color: var(--shop-navy);
		background:
			radial-gradient(circle at 8% 0%, rgba(255, 201, 40, 0.2), transparent 28%),
			radial-gradient(circle at 92% 12%, rgba(20, 88, 255, 0.14), transparent 26%),
			linear-gradient(180deg, #ffffff 0%, #f3f7ff 42%, #ffffff 100%);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
	}

	.shop-container {
		width: min(1180px, calc(100% - 36px));
		margin: 0 auto;
	}

	.shop-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(7, 20, 38, 0.94);
		backdrop-filter: blur(14px);
	}

	.shop-header-inner,
	.shop-brand,
	.shop-top-nav,
	.shop-hero-actions,
	.shop-support-inner,
	.shop-support-links,
	.shop-categories,
	.shop-category-title,
	.shop-product-top,
	.shop-product-bottom,
	.shop-note-card,
	.shop-footer-inner {
		display: flex;
		align-items: center;
	}

	.shop-header-inner,
	.shop-support-inner,
	.shop-product-bottom,
	.shop-footer-inner {
		justify-content: space-between;
		gap: 18px;
	}

	.shop-header-inner {
		min-height: 82px;
	}

	.shop-brand {
		gap: 13px;
		color: var(--shop-white);
	}

	.shop-logo {
		width: 54px;
		height: 54px;
		overflow: hidden;
		border: 2px solid rgba(255, 201, 40, 0.88);
		border-radius: 16px;
		background: var(--shop-white);
	}

	.shop-logo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.shop-brand strong,
	h1,
	h2,
	h3,
	h4 {
		font-family: 'Syne', sans-serif;
	}

	.shop-brand strong,
	.shop-brand small {
		display: block;
	}

	.shop-brand small {
		margin-top: 2px;
		color: rgba(255, 255, 255, 0.68);
		font-weight: 700;
	}

	.shop-top-nav {
		gap: 10px;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.shop-top-nav a,
	.shop-button,
	.shop-categories a,
	.shop-product-bottom a,
	.shop-support-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--shop-radius-pill);
		font-weight: 900;
		transition: transform 170ms ease, box-shadow 170ms ease, background 170ms ease;
	}

	.shop-top-nav a {
		min-height: 42px;
		padding: 0 16px;
		color: rgba(255, 255, 255, 0.78);
	}

	.shop-top-nav a:hover,
	.shop-button:hover,
	.shop-categories a:hover,
	.shop-product-bottom a:hover,
	.shop-support-links a:hover {
		transform: translateY(-1px);
	}

	.shop-top-nav .shop-discord {
		color: var(--shop-navy);
		background: var(--shop-yellow);
	}

	.shop-hero {
		padding: clamp(34px, 6vw, 72px) 0 26px;
		background:
			linear-gradient(135deg, rgba(7, 20, 38, 0.94) 0%, rgba(10, 40, 101, 0.92) 48%, rgba(20, 88, 255, 0.86) 100%),
			url('/midnight-toronto/assets/images/midnight-city/171-brasil-roleplay-logo-v3.png');
		background-size: cover;
		background-position: center;
	}

	.shop-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(310px, 0.42fr);
		gap: 22px;
		align-items: stretch;
	}

	.shop-hero-card,
	.shop-account-card {
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: var(--shop-radius-lg);
		box-shadow: 0 22px 54px rgba(0, 0, 0, 0.18);
	}

	.shop-hero-card {
		padding: clamp(28px, 5vw, 48px);
		color: var(--shop-white);
		background:
			radial-gradient(circle at top right, rgba(255, 201, 40, 0.24), transparent 32%),
			rgba(255, 255, 255, 0.06);
	}

	.shop-eyebrow,
	.shop-section-label {
		color: var(--shop-blue);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.shop-hero-card .shop-eyebrow {
		color: var(--shop-yellow);
	}

	h1,
	h2,
	h3,
	h4 {
		letter-spacing: -0.035em;
		line-height: 0.98;
	}

	h1 {
		max-width: 10ch;
		margin-top: 12px;
		font-size: clamp(3.1rem, 7vw, 5.9rem);
	}

	h2 {
		font-size: clamp(1.65rem, 3vw, 2.55rem);
	}

	h3 {
		font-size: clamp(1.45rem, 2.5vw, 2.2rem);
	}

	h4 {
		font-size: 1.35rem;
	}

	p {
		color: var(--shop-muted);
		font-size: 1rem;
		line-height: 1.65;
	}

	.shop-hero-card p:not(.shop-eyebrow) {
		max-width: 56ch;
		margin-top: 16px;
		color: rgba(255, 255, 255, 0.82);
		font-size: clamp(1.04rem, 1.8vw, 1.22rem);
		font-weight: 700;
	}

	.shop-hero-actions {
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 26px;
	}

	.shop-button {
		min-height: 52px;
		padding: 0 20px;
	}

	.shop-button-primary {
		color: var(--shop-navy);
		background: linear-gradient(135deg, var(--shop-yellow) 0%, #ffe27a 100%);
		box-shadow: 0 16px 30px rgba(255, 201, 40, 0.26);
	}

	.shop-button-light {
		color: var(--shop-white);
		border: 1px solid rgba(255, 255, 255, 0.22);
		background: rgba(255, 255, 255, 0.08);
	}

	.shop-account-card {
		padding: 26px;
		background: rgba(255, 255, 255, 0.96);
	}

	.shop-card-icon {
		display: grid;
		width: 58px;
		height: 58px;
		place-items: center;
		border-radius: 18px;
		background: var(--shop-yellow);
		font-size: 1.9rem;
	}

	.shop-account-card h2 {
		margin-top: 18px;
	}

	.shop-account-card p {
		margin-top: 12px;
	}

	.shop-account-card label {
		display: block;
		margin-top: 20px;
		margin-bottom: 8px;
		font-size: 0.86rem;
		font-weight: 900;
		color: var(--shop-navy);
	}

	.shop-id-preview {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 8px;
		padding: 8px;
		border: 1px solid var(--shop-line);
		border-radius: 18px;
		background: var(--shop-ice);
	}

	.shop-id-preview input,
	.shop-id-preview button {
		min-width: 0;
		border: 0;
		font: inherit;
		font-weight: 800;
	}

	.shop-id-preview input {
		width: 100%;
		padding: 0 10px;
		color: var(--shop-navy);
		background: transparent;
		outline: none;
	}

	.shop-id-preview button {
		min-height: 42px;
		padding: 0 16px;
		border-radius: 14px;
		color: var(--shop-white);
		background: var(--shop-blue);
	}

	.shop-support {
		padding: 22px 0;
	}

	.shop-support-inner {
		padding: 18px;
		border: 1px solid var(--shop-line);
		border-radius: var(--shop-radius-lg);
		background: var(--shop-white);
		box-shadow: var(--shop-shadow);
	}

	.shop-support h2 {
		margin-top: 4px;
		font-size: 1.35rem;
	}

	.shop-support-links {
		gap: 10px;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.shop-support-links a {
		min-height: 42px;
		padding: 0 16px;
		border: 1px solid var(--shop-line);
		background: var(--shop-ice);
		color: var(--shop-navy);
	}

	.shop-products {
		padding: clamp(36px, 6vw, 72px) 0;
	}

	.shop-section-head {
		display: grid;
		gap: 8px;
	}

	.shop-categories {
		position: sticky;
		top: 96px;
		z-index: 10;
		gap: 10px;
		overflow-x: auto;
		margin: 24px 0 30px;
		padding: 10px;
		border: 1px solid rgba(7, 20, 38, 0.08);
		border-radius: 22px;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(14px);
		box-shadow: 0 14px 28px rgba(7, 20, 38, 0.08);
	}

	.shop-categories a {
		flex: 0 0 auto;
		min-height: 46px;
		gap: 8px;
		padding: 0 18px;
		color: var(--shop-navy);
		background: var(--shop-ice);
		border: 1px solid transparent;
	}

	.shop-categories a:first-child,
	.shop-categories a:hover {
		border-color: rgba(255, 201, 40, 0.62);
		background: var(--shop-yellow);
	}

	.shop-category-block {
		scroll-margin-top: 178px;
		margin-top: 34px;
	}

	.shop-category-title {
		gap: 10px;
		margin-bottom: 16px;
	}

	.shop-category-title span {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border-radius: 14px;
		background: var(--shop-yellow);
		font-size: 1.35rem;
	}

	.shop-grid {
		display: grid;
