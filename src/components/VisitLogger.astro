---
const endpoint = import.meta.env.PUBLIC_VISIT_LOGGER_ENDPOINT || '';
---

{endpoint && (
	<script is:inline define:vars={{ endpoint }}>
		(() => {
			if (!endpoint || window.__midnightVisitLogged) {
				return;
			}

			window.__midnightVisitLogged = true;
			const sessionId = window.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;
			const openedAt = Date.now();
			const visitorIdKey = 'midnight-visitor-id-v1';
			const locationGrantKey = 'midnight-location-consent-v1';
			let visitorId = null;
			let deviceModel = null;
			let locationPermission = null;
			let latestLocation = null;
			const pageLanguage = (document.documentElement.lang || navigator.language || 'pt').toLowerCase();
			const locationCopy = pageLanguage.startsWith('en')
				? {
					title: 'Use precise location?',
					body: 'With your permission, we save precise location to improve access review.',
					allow: 'Allow',
					dismiss: 'Not now'
				}
				: {
					title: 'Usar localização precisa?',
					body: 'Com sua permissão, salvamos a localização exata para melhorar a leitura dos acessos.',
					allow: 'Permitir',
					dismiss: 'Agora não'
				};

			const randomId = () => window.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;

			const readVisitorId = () => {
				try {
					let storedVisitorId = window.localStorage.getItem(visitorIdKey);
					if (!storedVisitorId) {
						storedVisitorId = `mtv_${randomId()}`;
						window.localStorage.setItem(visitorIdKey, storedVisitorId);
					}

					return storedVisitorId;
				} catch {
					return `mtv_session_${randomId()}`;
				}
			};

			const basePayload = (event) => {
				const payload = {
					event,
					sessionId,
					visitorId,
					durationSeconds: Math.max(0, Math.round((Date.now() - openedAt) / 1000)),
					path: `${window.location.pathname}${window.location.search}`,
					referrer: document.referrer || null,
					deviceModel,
					locationPermission,
					browserLanguage: navigator.language || null,
					browserTimezone: Intl.DateTimeFormat().resolvedOptions().timeZone || null,
					screenWidth: window.screen?.width || null,
					screenHeight: window.screen?.height || null,
					viewportWidth: window.innerWidth || null,
					viewportHeight: window.innerHeight || null,
					pixelRatio: window.devicePixelRatio || null
				};

				return latestLocation ? { ...payload, ...latestLocation } : payload;
			};

			const send = (data) => {
				try {
					fetch(endpoint, {
						method: 'POST',
						headers: { 'content-type': 'text/plain;charset=UTF-8' },
						body: JSON.stringify(data),
						keepalive: true,
						credentials: 'omit',
						mode: 'no-cors'
					}).catch(() => {});
				} catch {
					/* The logger must never affect the visitor experience. */
				}
			};

			const closeSession = () => {
				send(basePayload('close'));
			};

			let sessionEventsInstalled = false;
			const installSessionEvents = () => {
				if (sessionEventsInstalled) {
					return;
				}

				sessionEventsInstalled = true;
				window.setInterval(() => send(basePayload('heartbeat')), 15000);
				window.addEventListener('pagehide', closeSession, { capture: true });
				window.addEventListener('beforeunload', closeSession, { capture: true });
			};

			const readStoredGrant = () => {
				try {
					return window.localStorage.getItem(locationGrantKey) === 'granted' ? 'granted' : null;
				} catch {
					return null;
				}
			};

			const saveStoredGrant = () => {
				try {
					window.localStorage.setItem(locationGrantKey, 'granted');
				} catch {
					/* Storage can be unavailable in private or restricted browsing. */
				}
			};

			const clearStoredGrant = () => {
				try {
					window.localStorage.removeItem(locationGrantKey);
				} catch {
					/* Storage can be unavailable in private or restricted browsing. */
				}
			};

			const readGeolocationPermission = async () => {
				if (!('geolocation' in navigator)) {
					return 'unsupported';
				}

				try {
					if (navigator.permissions?.query) {
						const permission = await navigator.permissions.query({ name: 'geolocation' });
						return permission.state;
					}
				} catch {
					/* Permission state is not available in every browser. */
				}

				return readStoredGrant() || 'prompt';
			};

			const readDeviceModel = async () => {
				const uaData = navigator.userAgentData;
				if (!uaData?.getHighEntropyValues) {
					return;
				}

				try {
					const hints = await uaData.getHighEntropyValues(['model']);
					if (hints.model) {
						deviceModel = hints.model;
					}
				} catch {
					/* Device hints are optional and may be blocked by the browser. */
				}
			};

			const collectPreciseLocation = () => new Promise((resolve) => {
				if (!('geolocation' in navigator)) {
					resolve({ permission: 'unsupported', location: null });
					return;
				}

				navigator.geolocation.getCurrentPosition(
					(position) => {
						saveStoredGrant();
						resolve({
							permission: 'granted',
							location: {
								preciseLatitude: position.coords.latitude,
								preciseLongitude: position.coords.longitude,
								preciseAccuracy: position.coords.accuracy,
								preciseAltitude: position.coords.altitude,
								preciseHeading: position.coords.heading,
								preciseSpeed: position.coords.speed
							}
						});
					},
					(error) => {
						if (error.code === error.PERMISSION_DENIED) {
							clearStoredGrant();
							resolve({ permission: 'denied', location: null });
							return;
						}

						resolve({ permission: 'unavailable', location: null });
					},
					{
						enableHighAccuracy: true,
						timeout: 10000,
						maximumAge: 300000
					}
				);
			});

			const applyLocationResult = (result) => {
				locationPermission = result.permission;
				latestLocation = result.location;
			};

			const requestPreciseLocation = async () => {
				const result = await collectPreciseLocation();
				applyLocationResult(result);
				send(basePayload('location'));
				document.querySelector('[data-location-consent]')?.remove();
			};

			const showLocationConsent = async () => {
				if (!('geolocation' in navigator)) {
					return;
				}

				if (document.querySelector('[data-location-consent]')) {
					return;
				}

				locationPermission = await readGeolocationPermission();
				if (locationPermission === 'granted') {
					await requestPreciseLocation();
					return;
				}

				if (locationPermission === 'unsupported') {
					return;
				}

				const banner = document.createElement('div');
				banner.className = 'location-consent';
				banner.dataset.locationConsent = 'true';
				banner.innerHTML = `
					<div>
						<strong>${locationCopy.title}</strong>
						<span>${locationCopy.body}</span>
					</div>
					<button type="button" data-location-allow>${locationCopy.allow}</button>
					<button type="button" data-location-dismiss>${locationCopy.dismiss}</button>
				`;

				banner.querySelector('[data-location-allow]')?.addEventListener('click', requestPreciseLocation);
				banner.querySelector('[data-location-dismiss]')?.addEventListener('click', () => {
					locationPermission = 'dismissed';
					send(basePayload('location'));
					banner.remove();
				});

				document.body.appendChild(banner);
			};

			const startSession = async () => {
				visitorId = readVisitorId();
				locationPermission = await readGeolocationPermission();
				if (locationPermission === 'granted') {
					applyLocationResult(await collectPreciseLocation());
				}

				send(basePayload('start'));
				installSessionEvents();
				window.setTimeout(showLocationConsent, 1800);
			};

			readDeviceModel().finally(() => {
				startSession().catch(() => {
					locationPermission = 'prompt';
					send(basePayload('start'));
					installSessionEvents();
					window.setTimeout(showLocationConsent, 1800);
				});
			});
		})();
	</script>
)}
