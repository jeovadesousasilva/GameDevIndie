---
const endpoint = import.meta.env.PUBLIC_VISIT_LOGGER_ENDPOINT || '';
---

{endpoint && (
	<script is:inline define:vars={{ endpoint }}>
		(() => {
			if (!endpoint || window.__midnightVisitLogged) {
				return;
			}

			window.__midnightVisitLogged = true;

			const payload = JSON.stringify({
				path: `${window.location.pathname}${window.location.search}`,
				referrer: document.referrer || null
			});

			try {
				fetch(endpoint, {
					method: 'POST',
					headers: { 'content-type': 'text/plain;charset=UTF-8' },
					body: payload,
					keepalive: true,
					credentials: 'omit',
					mode: 'no-cors'
				}).catch(() => {});
			} catch {
				/* The logger must never affect the visitor experience. */
			}
		})();
	</script>
)}
