---
import { withBase } from '../utils/paths';
import { studioHomeContent, type StudioLocale } from '../content/studioHome';
import VisitLogger from './VisitLogger.astro';

interface Props {
	locale: StudioLocale;
}

const { locale } = Astro.props;
const content = studioHomeContent[locale];

const faviconHref = withBase('favicon.png');
const studioAsset = withBase('midnight-toronto/assets');
const siteUrl = 'https://midnighttoronto.com.br';
const isEnglish = locale === 'en';
const pagePath = isEnglish ? 'en/' : '';
const canonicalUrl = `${siteUrl}${withBase(pagePath)}`;
const ptUrl = `${siteUrl}${withBase()}`;
const enUrl = `${siteUrl}${withBase('en/')}`;
const logoUrl = `${siteUrl}${withBase('midnight-toronto/assets/images/logobackground.png')}`;

const navSections = [
	{ href: '#vision', label: content.nav.vision },
	{ href: '#projects', label: content.nav.projects },
	{ href: '#contact', label: content.nav.contact }
];

const shellboundProject = content.projects.items.find((project) => project.title === 'Shellbound');
const shellboundImage = `${studioAsset}/images/Game04img02-1200.webp`;
const shellboundIcon = `${studioAsset}/images/Game04img01-320.webp`;
const shellboundSignals = isEnglish
	? [
			{ value: '2D', label: 'clear battlefield' },
			{ value: 'Turns', label: 'one move at a time' },
			{ value: 'Aim', label: 'shots with consequence' },
			{ value: 'Terrain', label: 'position changes the fight' }
		]
	: [
			{ value: '2D', label: 'campo fácil de ler' },
			{ value: 'Turnos', label: 'uma decisão por vez' },
			{ value: 'Mira', label: 'disparos com consequência' },
			{ value: 'Terreno', label: 'posição muda a luta' }
		];

const socialLinks = [
	{
		platform: 'play',
		href: 'https://play.google.com/store/apps/dev?id=8606518036992652230',
		label: isEnglish ? 'Released games' : 'Jogos publicados',
		description: isEnglish
			? 'Open the studio page on Google Play.'
			: 'Abra a página do estúdio no Google Play.'
	},
	{
		platform: 'instagram',
		href: 'https://www.instagram.com/midnight_toronto?igsh=Znh6c2g4d3YyNHJo',
		label: isEnglish ? 'Instagram updates' : 'Novidades no Instagram',
		description: isEnglish
			? 'Follow public updates and work-in-progress posts.'
			: 'Acompanhe novidades públicas e bastidores.'
	}
];

const contactSignal = isEnglish
	? {
			label: 'Next signal',
			title: 'Shellbound is in the workshop.',
			description: 'Turn-based 2D tank battles are still in development. Public news will land here first.'
		}
	: {
			label: 'Próximo sinal',
			title: 'Shellbound está na oficina.',
			description: 'As batalhas 2D por turnos ainda estão em produção. Quando houver novidade pública, ela aparece por aqui primeiro.'
		};
---

<!DOCTYPE html>
<html lang={content.locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{content.seo.title}</title>
		<meta name="description" content={content.seo.description} />
		<meta name="keywords" content={content.seo.keywords} />
		<meta name="author" content="Jeova de Sousa" />
		<meta name="robots" content="index, follow" />
		<meta name="google-site-verification" content="pKUvH27rY-k1qWgK6HieRd_swEtUzO55_O2B_w7e_no" />
		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6075325186753310"
			crossorigin="anonymous"
		></script>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="pt-BR" href={ptUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={ptUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={content.seo.ogLocale} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={content.seo.title} />
		<meta property="og:description" content={content.seo.description} />
		<meta property="og:image" content={logoUrl} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={content.seo.title} />
		<meta property="twitter:description" content={content.seo.description} />
		<meta property="twitter:image" content={logoUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bungee&family=Manrope:wght@400;500;600;700;800&family=Syne:wght@500;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href={withBase('midnight-toronto/assets/css/style.css')} />
		<link rel="icon" type="image/png" href={faviconHref} />
	</head>
	<body>
		<div class="page-shell">
			<header class="header">
				<div class="container header-content">
					<a href={isEnglish ? withBase('en/') : withBase()} class="logo" aria-label="Midnight Toronto">
						<img
							src={`${studioAsset}/images/logobackground.png`}
							alt="Midnight Toronto"
							class="logo-img"
						/>
						<div class="logo-copy">
							<span class="logo-name">Midnight Toronto</span>
							<span class="logo-tag">{content.hero.eyebrow}</span>
						</div>
					</a>

					<button
						class="mobile-menu-toggle"
						aria-label={content.nav.menu}
						aria-expanded="false"
						aria-controls="studio-nav"
						data-label-open={content.nav.menu}
						data-label-close={content.nav.close}
					>
						<span aria-hidden="true">{content.nav.menu}</span>
					</button>

					<nav class="nav" id="studio-nav">
						<ul class="nav-list">
							{navSections.map((item, index) => (
								<li>
									<a
										href={item.href}
										class={`nav-link ${index === 0 ? 'active' : ''}`.trim()}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>

						<div class="language-switcher" aria-label={content.nav.languageLabel}>
							<a href={withBase()} class:list={['language-link', !isEnglish && 'active']}>PT</a>
							<a href={withBase('en/')} class:list={['language-link', isEnglish && 'active']}>EN</a>
						</div>
					</nav>
				</div>
			</header>

			<main>
				<section id="hero" class="hero">
					<div class="hero-backdrop"></div>
					<div class="container hero-grid">
						<div class="hero-copy">
							<p class="eyebrow">{content.hero.eyebrow}</p>
							<h1 class="hero-title">{content.hero.title}</h1>
							<p class="hero-subtitle">{content.hero.subtitle}</p>
							<div class="hero-cta">
								<a href="#shellbound" class="btn btn-primary">{content.hero.primaryCta}</a>
								<a href="#projects" class="btn btn-secondary">
									{isEnglish ? 'Full catalog' : 'Catálogo completo'}
								</a>
							</div>
						</div>

						<div class="hero-panel shellbound-showcase">
							<img
								src={shellboundImage}
								alt={shellboundProject?.imageAlt || 'Shellbound'}
								class="hero-art"
							/>
							<img src={shellboundIcon} alt="" class="shellbound-icon" aria-hidden="true" />
							<div class="hero-panel-copy">
								<span>{shellboundProject?.status}</span>
								<p>{shellboundProject?.note}</p>
							</div>
						</div>
					</div>
					<div class="scroll-indicator">
						<span>{content.hero.scrollHint}</span>
					</div>
				</section>

				<section class="shellbound-brief" aria-label="Shellbound">
					<div class="container shellbound-brief-grid">
						{shellboundSignals.map((signal) => (
							<div class="signal-card">
								<strong>{signal.value}</strong>
								<span>{signal.label}</span>
							</div>
						))}
					</div>
				</section>

				<section id="vision" class="section section-vision">
					<div class="container section-grid">
						<div class="section-heading">
							<p class="section-kicker">{content.vision.kicker}</p>
							<h2 class="section-title">{content.vision.title}</h2>
						</div>

						<div class="vision-layout">
							<div class="vision-copy">
								{content.vision.body.map((paragraph) => <p>{paragraph}</p>)}
							</div>
							<aside class="vision-notes">
								<div class="vision-note-card">
									<h3>{content.vision.intro}</h3>
									<ul>
										{content.vision.notes.map((note) => <li>{note}</li>)}
									</ul>
								</div>
								<div class="stats-grid">
									{content.vision.stats.map((stat) => (
										<div class="stat-item">
											<span class="stat-value">{stat.value}</span>
											<span class="stat-label">{stat.label}</span>
										</div>
									))}
								</div>
							</aside>
						</div>
					</div>
				</section>

				<section id="projects" class="section section-projects">
					<div class="container section-grid">
						<div class="section-heading section-heading-inline">
							<div>
								<p class="section-kicker">{content.projects.kicker}</p>
								<h2 class="section-title">{content.projects.title}</h2>
							</div>
						</div>

						<p class="section-intro">{content.projects.intro}</p>

						<div class="projects-grid">
							{content.projects.items.map((project) => (
								<article
									id={project.title === 'Shellbound' ? 'shellbound' : undefined}
									class:list={['project-card', project.title === 'Shellbound' && 'project-card-featured']}
								>
									<div class="project-art">
										<img
											src={`${studioAsset}/images/${project.image}`}
											alt={project.imageAlt}
											class:list={[project.title === 'Shellbound' && 'project-art-cover']}
										/>
									</div>
									<div class="project-body">
										<div class="project-meta">
											<span class="project-category">{project.category}</span>
											<span class="project-status">{project.status}</span>
										</div>
										<h3>{project.title}</h3>
										<p>{project.description}</p>
										<p class="project-note">{project.note}</p>
										{project.downloadUrl && project.downloadLabel && (
											<div class="project-actions">
												<a
													href={project.downloadUrl}
													target="_blank"
													rel="noreferrer"
													class="project-download play-store-badge"
													aria-label={project.downloadLabel}
												>
													<span class="play-badge-icon" aria-hidden="true">
														<svg viewBox="0 0 24 24" focusable="false">
															<path class="play-cyan" d="M4.7 3.2 14.2 12 4.7 20.8a2 2 0 0 1-.45-1.26V4.46c0-.48.16-.92.45-1.26Z" />
															<path class="play-green" d="M5.6 2.62c.58-.18 1.24-.09 1.84.26l8.8 5.05-2.04 4.07L5.6 2.62Z" />
															<path class="play-yellow" d="M16.24 7.93 19.46 9.78c1.38.79 1.38 2.65 0 3.44l-3.22 1.85L14.2 12l2.04-4.07Z" />
															<path class="play-red" d="m5.6 21.38 8.6-9.38 2.04 4.07-8.8 5.05c-.6.35-1.26.44-1.84.26Z" />
														</svg>
													</span>
													<span class="play-badge-copy">
														<span class="play-badge-kicker">{isEnglish ? 'GET IT ON' : 'BAIXAR NA'}</span>
														<strong>Google Play</strong>
													</span>
												</a>
											</div>
										)}
									</div>
								</article>
							))}
						</div>
					</div>
				</section>

				<section id="contact" class="section section-contact">
					<div class="container contact-panel">
						<div class="contact-copy">
							<p class="section-kicker">{content.contact.kicker}</p>
							<h2 class="section-title">{content.contact.title}</h2>
							<p>{content.contact.description}</p>

							<div class="contact-signal">
								<img src={shellboundIcon} alt="" class="contact-signal-icon" aria-hidden="true" />
								<div>
									<span>{contactSignal.label}</span>
									<strong>{contactSignal.title}</strong>
									<p>{contactSignal.description}</p>
								</div>
							</div>
						</div>

						<div class="contact-actions">
							<span class="contact-label">{content.contact.socialsLabel}</span>
							<div class="social-links">
								{socialLinks.map((social) => (
									<a
										href={social.href}
										target="_blank"
										rel="noreferrer"
										class:list={['social-link', `social-link-${social.platform}`]}
									>
										<span class="social-icon" aria-hidden="true">
											{social.platform === 'play' ? (
												<svg viewBox="0 0 24 24" focusable="false">
													<path class="play-cyan" d="M4.7 3.2 14.2 12 4.7 20.8a2 2 0 0 1-.45-1.26V4.46c0-.48.16-.92.45-1.26Z" />
													<path class="play-green" d="M5.6 2.62c.58-.18 1.24-.09 1.84.26l8.8 5.05-2.04 4.07L5.6 2.62Z" />
													<path class="play-yellow" d="M16.24 7.93 19.46 9.78c1.38.79 1.38 2.65 0 3.44l-3.22 1.85L14.2 12l2.04-4.07Z" />
													<path class="play-red" d="m5.6 21.38 8.6-9.38 2.04 4.07-8.8 5.05c-.6.35-1.26.44-1.84.26Z" />
												</svg>
											) : (
												<svg viewBox="0 0 24 24" focusable="false">
													<rect x="4.5" y="4.5" width="15" height="15" rx="4.2" />
													<circle cx="12" cy="12" r="3.45" />
													<circle cx="16.45" cy="7.55" r="1" />
												</svg>
											)}
										</span>
										<span class="social-copy">
											<strong>{social.label}</strong>
											<span>{social.description}</span>
										</span>
									</a>
								))}
							</div>
						</div>
					</div>
				</section>
			</main>

			<footer class="footer">
				<div class="container footer-content">
					<p>{content.contact.rights} &copy; 2026</p>
					<div class="footer-links">
						<a href="#vision">{content.nav.vision}</a>
						<a href="#projects">{content.nav.projects}</a>
					</div>
				</div>
			</footer>

			<button
				class="back-to-top"
				type="button"
				aria-label={isEnglish ? 'Back to top' : 'Voltar ao topo'}
				data-back-to-top
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M12 5.8 5.9 11.9l1.7 1.7 3.2-3.2v7.8h2.4v-7.8l3.2 3.2 1.7-1.7L12 5.8Z" />
				</svg>
			</button>
		</div>

		<script src={withBase('midnight-toronto/assets/js/main.js')}></script>
		<VisitLogger />
	</body>
</html>
