---
import { withBase } from '../utils/paths';

interface Props {
	locale: 'pt-BR' | 'en';
}

const { locale } = Astro.props;
const isEnglish = locale === 'en';
const siteUrl = 'https://midnighttoronto.com.br';
const pagePath = isEnglish ? 'en/171-brasil-roleplay/' : '171-brasil-roleplay/';
const canonicalUrl = `${siteUrl}${withBase(pagePath)}`;
const ptUrl = `${siteUrl}${withBase('171-brasil-roleplay/')}`;
const enUrl = `${siteUrl}${withBase('en/171-brasil-roleplay/')}`;
const homeUrl = withBase(isEnglish ? 'en/' : '');
const faviconHref = withBase('favicon.png');
const studioAsset = withBase('midnight-toronto/assets');
const serverAsset = withBase('midnight-toronto/assets/images/171-brasil-roleplay');
const discordUrl = 'https://discord.gg/6GwbJRFhQU';
const storeUrl = withBase('loja/');
const logoImage = `${studioAsset}/images/midnight-city/171-brasil-roleplay-logo-v3.png`;
const socialImage = `${siteUrl}${withBase('midnight-toronto/assets/images/midnight-city/171-brasil-roleplay-logo-v3.png')}`;

const content = isEnglish
	? {
			locale: 'en',
			seoTitle: '171 Brasil Roleplay | SA-MP Mobile server by Midnight Toronto',
			seoDescription:
				'171 Brasil Roleplay is a SA-MP Mobile roleplay server project by Midnight Toronto, with inventory, garages, vehicle trunks, mobile HUD and in-game systems.',
			backLabel: 'Midnight Toronto',
			storeLabel: 'Store',
			supportLabel: 'Support',
			kicker: 'SA-MP Mobile roleplay',
			title: 'A Brazilian roleplay city built for mobile.',
			description:
				'171 Brasil Roleplay is being shaped as a complete city experience: account progression, vehicles, inventory, garage slots, economy and immersive systems prepared for the official launch.',
			primaryCta: 'Open server store',
			secondaryCta: 'View systems',
			badges: ['Mobile-first', 'Custom systems', 'Project by Midnight Toronto'],
			systemsTitle: 'Server systems',
			systemsIntro:
				'A cleaner look for the website, showing what the player can expect inside the city without turning the homepage into only a Discord invite.',
			features: [
				{
					title: 'Inventory and backpack',
					description: 'Organized slots, item weight and quick actions for daily roleplay.',
					image: `${serverAsset}/inventario.png`,
					label: 'Inventory'
				},
				{
					title: 'Garage and vehicle slots',
					description: 'A visual garage for personal and work vehicles, with fuel, armor and condition details.',
					image: `${serverAsset}/garagem.png`,
					label: 'Garage'
				},
				{
					title: 'Vehicle trunk',
					description: 'Vehicle storage designed for player logistics and roleplay economy.',
					image: `${serverAsset}/bau-veiculo.png`,
					label: 'Trunk'
				},
				{
					title: 'Mobile gameplay',
					description: 'Interface and HUD prepared for a comfortable SA-MP Mobile experience.',
					image: `${serverAsset}/mobile-gameplay.png`,
					label: 'Mobile'
				},
				{
					title: 'Illegal economy areas',
					description: 'Restricted markets and risky interactions to create story opportunities.',
					image: `${serverAsset}/armas-ilegais.png`,
					label: 'Roleplay'
				}
			],
			stats: [
				['Focus', 'SA-MP Mobile'],
				['Store', 'Pix integration'],
				['Delivery', 'Automatic queue']
			],
			ctaTitle: 'Follow the project and prepare your account for launch.',
			ctaDescription:
				'The store preview is already connected to the purchase flow, while the server systems continue evolving toward the official release.',
			rights:
				'Midnight Toronto © 2026. 171 Brasil Roleplay is a Midnight Toronto project. All rights reserved.'
		}
	: {
			locale: 'pt-BR',
			seoTitle: '171 Brasil Roleplay | Servidor SA-MP Mobile da Midnight Toronto',
			seoDescription:
				'171 Brasil Roleplay é um servidor de SA-MP Mobile em desenvolvimento pela Midnight Toronto, com inventário, garagem, baú, HUD mobile e sistemas próprios.',
			backLabel: 'Midnight Toronto',
			storeLabel: 'Loja',
			supportLabel: 'Suporte',
			kicker: 'Roleplay SA-MP Mobile',
			title: 'Uma cidade brasileira feita para jogar no celular.',
			description:
				'O 171 Brasil Roleplay está sendo construído como uma experiência completa de cidade: evolução de conta, veículos, inventário, garagem, economia e sistemas imersivos preparados para a abertura oficial.',
			primaryCta: 'Abrir loja do servidor',
			secondaryCta: 'Ver sistemas',
			badges: ['Pensado para mobile', 'Sistemas próprios', 'Projeto Midnight Toronto'],
			systemsTitle: 'Sistemas do servidor',
			systemsIntro:
				'A página agora apresenta o servidor com calma, mostrando o que o jogador pode esperar dentro da cidade, sem parecer apenas um convite para Discord.',
			features: [
				{
					title: 'Inventário e mochila',
					description: 'Slots organizados, peso dos itens e ações rápidas para o roleplay do dia a dia.',
					image: `${serverAsset}/inventario.png`,
					label: 'Inventário'
				},
				{
					title: 'Garagem e slots',
					description: 'Garagem visual para veículos pessoais e de trabalho, com combustível, blindagem e lataria.',
					image: `${serverAsset}/garagem.png`,
					label: 'Garagem'
				},
				{
					title: 'Baú de veículos',
					description: 'Armazenamento no veículo para dar mais peso à economia e à logística dos jogadores.',
					image: `${serverAsset}/bau-veiculo.png`,
					label: 'Baú'
				},
				{
					title: 'Gameplay mobile',
					description: 'Interface e HUD preparados para uma experiência confortável no SA-MP Mobile.',
					image: `${serverAsset}/mobile-gameplay.png`,
					label: 'Mobile'
				},
				{
					title: 'Áreas de economia ilegal',
					description: 'Mercados restritos e interações de risco para criar histórias dentro do roleplay.',
					image: `${serverAsset}/armas-ilegais.png`,
					label: 'Roleplay'
				}
			],
			stats: [
				['Foco', 'SA-MP Mobile'],
				['Loja', 'Pix integrado'],
				['Entrega', 'Fila automática']
			],
			ctaTitle: 'Acompanhe o projeto e prepare sua conta para a abertura.',
			ctaDescription:
				'A loja já está em prévia com fluxo de compra, enquanto os sistemas do servidor evoluem para a versão oficial.',
			rights:
				'Midnight Toronto © 2026. 171 Brasil Roleplay é um projeto de Midnight Toronto. Todos os direitos reservados.'
		};
---

<!doctype html>
<html lang={content.locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{content.seoTitle}</title>
		<meta name="description" content={content.seoDescription} />
		<meta
			name="keywords"
			content="171 brasil roleplay, samp mobile, sa-mp mobile, servidor roleplay, midnight toronto"
		/>
		<meta name="author" content="Jeová de Sousa" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="pt-BR" href={ptUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={ptUrl} />
		<link rel="icon" type="image/png" href={faviconHref} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={isEnglish ? 'en_US' : 'pt_BR'} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={content.seoTitle} />
		<meta property="og:description" content={content.seoDescription} />
		<meta property="og:image" content={socialImage} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={content.seoTitle} />
		<meta property="twitter:description" content={content.seoDescription} />
		<meta property="twitter:image" content={socialImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="rp-page">
			<header class="rp-header">
				<div class="rp-container rp-header-inner">
					<a href={homeUrl} class="rp-brand" aria-label="Midnight Toronto">
						<span class="rp-logo">
							<img src={logoImage} alt="171 Brasil Roleplay" />
						</span>
						<span>
							<strong>171 Brasil RP</strong>
							<small>{content.backLabel}</small>
						</span>
					</a>

					<nav class="rp-nav" aria-label="Navegação principal">
						<a href={storeUrl}>{content.storeLabel}</a>
						<a href={discordUrl} target="_blank" rel="noreferrer">{content.supportLabel}</a>
					</nav>
				</div>
			</header>

			<main>
				<section class="rp-hero">
					<div class="rp-container rp-hero-grid">
						<div class="rp-hero-copy">
							<p class="rp-kicker">{content.kicker}</p>
							<h1>{content.title}</h1>
							<p class="rp-lead">{content.description}</p>

							<div class="rp-actions">
								<a href={storeUrl} class="rp-button rp-button-primary">{content.primaryCta}</a>
								<a href="#sistemas" class="rp-button rp-button-dark">{content.secondaryCta}</a>
							</div>

							<div class="rp-badges">
								{content.badges.map((badge) => <span>{badge}</span>)}
							</div>
						</div>

						<div class="rp-hero-showcase">
							<div class="rp-phone-frame">
								<img src={`${serverAsset}/mobile-gameplay.png`} alt="Gameplay mobile do 171 Brasil Roleplay" />
							</div>
							<div class="rp-stat-card">
								{content.stats.map(([label, value]) => (
									<article>
										<span>{label}</span>
										<strong>{value}</strong>
									</article>
								))}
							</div>
						</div>
					</div>
				</section>

				<section id="sistemas" class="rp-section">
					<div class="rp-container">
						<div class="rp-section-head">
							<p class="rp-kicker">171 Brasil Roleplay</p>
							<h2>{content.systemsTitle}</h2>
							<p>{content.systemsIntro}</p>
						</div>

						<div class="rp-gallery">
							{content.features.map((feature, index) => (
								<article class:list={['rp-feature-card', index === 0 && 'rp-feature-wide']}>
									<div class="rp-feature-image">
										<img src={feature.image} alt={feature.title} loading={index > 1 ? 'lazy' : undefined} />
										<span>{feature.label}</span>
									</div>
									<div class="rp-feature-body">
										<h3>{feature.title}</h3>
										<p>{feature.description}</p>
									</div>
								</article>
							))}
						</div>
					</div>
				</section>

				<section class="rp-section rp-final-section">
					<div class="rp-container">
						<div class="rp-final-card">
							<div>
								<p class="rp-kicker">Midnight Toronto</p>
								<h2>{content.ctaTitle}</h2>
								<p>{content.ctaDescription}</p>
							</div>
							<a href={storeUrl} class="rp-button rp-button-primary">{content.primaryCta}</a>
						</div>
					</div>
				</section>
			</main>

			<footer class="rp-footer">
				<div class="rp-container rp-footer-inner">
					<p>{content.rights}</p>
					<a href={homeUrl}>{content.backLabel}</a>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--rp-bg: #05070c;
		--rp-card: #0c0d11;
		--rp-card-soft: #111216;
		--rp-line: rgba(255, 255, 255, 0.13);
		--rp-text: #ffffff;
		--rp-muted: #b8c4d8;
		--rp-yellow: #ffc928;
		--rp-blue: #1458ff;
		--rp-blue-dark: #0c35a8;
		--rp-radius-xl: 34px;
		--rp-radius-lg: 24px;
		--rp-radius-pill: 999px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		min-width: 320px;
		font-family: 'Manrope', sans-serif;
		color: var(--rp-text);
		background: var(--rp-bg);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
	}

	.rp-page {
		min-height: 100vh;
		background:
			linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
			radial-gradient(circle at 82% 10%, rgba(255, 201, 40, 0.22), transparent 30%),
			radial-gradient(circle at 10% 20%, rgba(20, 88, 255, 0.18), transparent 28%),
			var(--rp-bg);
		background-size: 64px 64px, 64px 64px, auto, auto, auto;
	}

	.rp-container {
		width: min(1360px, calc(100% - 36px));
		margin: 0 auto;
	}

	.rp-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(5, 5, 7, 0.94);
		backdrop-filter: blur(14px);
	}

	.rp-header-inner,
	.rp-brand,
	.rp-nav,
	.rp-actions,
	.rp-badges,
	.rp-footer-inner {
		display: flex;
		align-items: center;
	}

	.rp-header-inner,
	.rp-footer-inner {
		justify-content: space-between;
		gap: 18px;
	}

	.rp-header-inner {
		min-height: 78px;
		padding-top: env(safe-area-inset-top);
	}

	.rp-brand {
		gap: 13px;
	}

	.rp-logo {
		display: grid;
		width: 50px;
		height: 50px;
		overflow: hidden;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		background: #050505;
	}

	.rp-logo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.rp-brand strong,
	.rp-kicker,
	.rp-badges span,
	.rp-nav a,
	.rp-button {
		font-weight: 900;
	}

	.rp-brand strong,
	h1,
	h2,
	h3 {
		font-family: 'Syne', sans-serif;
	}

	.rp-brand small {
		display: block;
		color: var(--rp-muted);
		font-size: 0.8rem;
	}

	.rp-nav {
		gap: 10px;
	}

	.rp-nav a,
	.rp-button {
		display: inline-flex;
		min-height: 46px;
		align-items: center;
		justify-content: center;
		padding: 0 18px;
		border-radius: var(--rp-radius-pill);
		transition: transform 180ms ease, border-color 180ms ease;
	}

	.rp-nav a {
		border: 1px solid var(--rp-line);
		background: rgba(255, 255, 255, 0.045);
		color: #edf2ff;
	}

	.rp-nav a:first-child,
	.rp-button-primary {
		border-color: rgba(255, 201, 40, 0.72);
		background: var(--rp-yellow);
		color: #071426;
		box-shadow: 0 18px 38px rgba(255, 201, 40, 0.18);
	}

	.rp-nav a:hover,
	.rp-button:hover {
		transform: translateY(-1px);
	}

	.rp-hero {
		padding: clamp(48px, 7vw, 96px) 0 clamp(44px, 7vw, 82px);
	}

	.rp-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(380px, 0.8fr);
		gap: clamp(26px, 5vw, 56px);
		align-items: center;
	}

	.rp-hero-copy,
	.rp-feature-card,
	.rp-final-card,
	.rp-stat-card {
		border: 1px solid var(--rp-line);
		background: linear-gradient(180deg, rgba(19, 20, 26, 0.94), rgba(9, 10, 14, 0.98));
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
	}

	.rp-hero-copy {
		padding: clamp(26px, 5vw, 50px);
		border-radius: var(--rp-radius-xl);
	}

	.rp-kicker {
		color: var(--rp-yellow);
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.045em;
		line-height: 0.96;
	}

	h1 {
		max-width: 12ch;
		margin-top: 14px;
		font-size: clamp(3.2rem, 8vw, 7rem);
	}

	h2 {
		font-size: clamp(2.2rem, 5vw, 4.5rem);
	}

	h3 {
		font-size: 1.35rem;
	}

	.rp-lead,
	.rp-section-head p,
	.rp-feature-body p,
	.rp-final-card p,
	.rp-footer p {
		color: var(--rp-muted);
		font-weight: 700;
		line-height: 1.7;
	}

	.rp-lead {
		max-width: 66ch;
		margin-top: 18px;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
	}

	.rp-actions,
	.rp-badges {
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.rp-button-dark {
		border: 1px solid var(--rp-line);
		background: rgba(255, 255, 255, 0.055);
		color: #ffffff;
	}

	.rp-badges {
		margin-top: 22px;
	}

	.rp-badges span {
		display: inline-flex;
		min-height: 38px;
		align-items: center;
		padding: 0 14px;
		border: 1px solid var(--rp-line);
		border-radius: var(--rp-radius-pill);
		background: rgba(255, 255, 255, 0.045);
		color: #dfe8f7;
		font-size: 0.84rem;
	}

	.rp-hero-showcase {
		display: grid;
		gap: 16px;
	}

	.rp-phone-frame {
		position: relative;
		overflow: hidden;
		padding: 10px;
		border: 1px solid var(--rp-line);
		border-radius: 32px;
		background:
			linear-gradient(135deg, rgba(255, 201, 40, 0.28), transparent 38%),
			rgba(255, 255, 255, 0.055);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
	}

	.rp-phone-frame::after,
	.rp-feature-image::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(180deg, transparent 42%, rgba(0, 0, 0, 0.55) 100%);
	}

	.rp-phone-frame img {
		width: 100%;
		aspect-ratio: 16 / 8.4;
		border-radius: 24px;
		object-fit: cover;
		filter: saturate(1.08) contrast(1.04);
	}

	.rp-stat-card {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		overflow: hidden;
		border-radius: var(--rp-radius-lg);
	}

	.rp-stat-card article {
		padding: 18px;
		background: rgba(255, 255, 255, 0.035);
	}

	.rp-stat-card span {
		display: block;
		color: var(--rp-muted);
		font-size: 0.76rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.rp-stat-card strong {
		display: block;
		margin-top: 6px;
		color: #ffffff;
		font-size: 1rem;
	}

	.rp-section {
		padding: clamp(54px, 7vw, 92px) 0;
	}

	.rp-section-head {
		max-width: 780px;
	}

	.rp-section-head h2 {
		margin-top: 10px;
	}

	.rp-section-head p {
		margin-top: 14px;
		font-size: 1.05rem;
	}

	.rp-gallery {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
		margin-top: 34px;
	}

	.rp-feature-card {
		overflow: hidden;
		border-radius: var(--rp-radius-lg);
	}

	.rp-feature-wide {
		grid-column: span 2;
	}

	.rp-feature-image {
		position: relative;
		overflow: hidden;
		min-height: 238px;
		background: #07080b;
	}

	.rp-feature-image img {
		width: 100%;
		height: 100%;
		min-height: 238px;
		object-fit: cover;
		filter: saturate(1.08) contrast(1.05) brightness(0.9);
		transform: scale(1.01);
	}

	.rp-feature-wide .rp-feature-image {
		min-height: 310px;
	}

	.rp-feature-wide .rp-feature-image img {
		min-height: 310px;
	}

	.rp-feature-image span {
		position: absolute;
		left: 16px;
		bottom: 16px;
		z-index: 1;
		display: inline-flex;
		min-height: 38px;
		align-items: center;
		padding: 0 14px;
		border: 1px solid rgba(255, 201, 40, 0.56);
		border-radius: var(--rp-radius-pill);
		background: rgba(255, 201, 40, 0.12);
		color: var(--rp-yellow);
		font-weight: 900;
	}

	.rp-feature-body {
		padding: 20px;
		border-top: 1px solid var(--rp-line);
	}

	.rp-feature-body p {
		margin-top: 10px;
	}

	.rp-final-section {
		padding-top: 0;
	}

	.rp-final-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 20px;
		align-items: center;
		padding: clamp(24px, 4vw, 40px);
		border-radius: var(--rp-radius-xl);
	}

	.rp-final-card h2 {
		margin-top: 10px;
		font-size: clamp(2rem, 4vw, 3.6rem);
	}

	.rp-final-card p {
		max-width: 62ch;
		margin-top: 12px;
	}

	.rp-footer {
		padding: 0 0 34px;
	}

	.rp-footer-inner {
		padding-top: 20px;
		border-top: 1px solid var(--rp-line);
	}

	.rp-footer a {
		color: var(--rp-yellow);
		font-weight: 900;
	}

	@media (max-width: 980px) {
		.rp-hero-grid,
		.rp-final-card {
			grid-template-columns: 1fr;
		}

		.rp-gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.rp-feature-wide {
			grid-column: span 2;
		}
